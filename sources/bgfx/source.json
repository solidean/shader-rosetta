    "license": "BSD-2-Clause",
    "license_file": "LICENSE",
    "include": [
        "src/bgfx_shader.sh",
        "src/bgfx_compute.sh",
        "examples/**/*.sc",
        "examples/**/*.sh",
        "examples/common/s2h/*.hlsl",
        "examples/46-fsr/*.h",
        "examples/**/makefile",
        "scripts/shader.mk"
    ],
    "exclude": [],
