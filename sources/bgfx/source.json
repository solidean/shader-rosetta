            ],
            "name": "AMD FidelityFX FSR 1",
            "license": "MIT",
            "copyright": "Copyright (c) 2021 Advanced Micro Devices, Inc.",
            "license_file": null
        },
        {
            "paths": [
                "examples/51-gpufont/vs_slug.sc",
                "examples/51-gpufont/fs_slug.sc"
            ],
            "name": "Slug reference shaders",
            "license": "MIT",
            "copyright": "Copyright 2017, by Eric Lengyel.",
            "license_file": null
        }
    ]
