binding view:
    view_proj: mat4

@vertex struct vertex_input:
    position: float3
    color0: float4
    @per_instance data0: float4
    @per_instance data1: float4
    @per_instance data2: float4
    @per_instance data3: float4
    @per_instance data4: float4

struct varyings:
    @position position: hpos4
    color0: float4

@vertex fun main(v: vertex_input){view} -> varyings:
    let model = mat4(v.data0, v.data1, v.data2, v.data3)

    let world_pos = model * float4(..v.position, 1.0)
    return {
        position = hpos4(..(view.view_proj * world_pos))
        color0 = v.color0 * v.data4
    }
