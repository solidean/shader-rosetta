// Translated to SGL from bgfx examples/45-bokeh/fs_bokeh_copy_linear_to_gamma.sc.
// Copyright 2021 elven cache. BSD-2-Clause: sources/bgfx/LICENSE.

binding material:
    color: texture_2d[float4]
    sampler s_tex:
        filter = .linear

struct varyings:
    @position position: hpos4
    texcoord0: float2

@pixel struct target:
    color: float4

// shaderlib.sh
fun to_gamma(rgb: float3) => pow(abs(rgb), float3(1.0 / 2.2))

@pixel fun main(p: varyings){material} -> target:
    let tex_coord = p.texcoord0
    let linear_color = material.color.sample(tex_coord, material.s_tex)

    // this pass is writing directly out to backbuffer, convert from linear to gamma
    let color = float4(..to_gamma(linear_color.xyz), linear_color.w)

    return {
        color = color
    }
