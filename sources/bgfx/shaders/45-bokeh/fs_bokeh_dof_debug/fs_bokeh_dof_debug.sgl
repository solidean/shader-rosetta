// Translated to SGL from bgfx examples/45-bokeh/fs_bokeh_dof_debug.sc, with parameters.sh and bokeh_dof.sh.
// Copyright 2021 elven cache. BSD-2-Clause: sources/bgfx/LICENSE.

// bgfx's u_params[13], one member per define of parameters.sh
binding params:
    depth_unpack_consts: float2
    frame_idx: float
    lobe_rotation: float
    ndc_to_view_mul: float2
    ndc_to_view_add: float2
    blur_steps: float
    // u_samplePattern names this lane too
    lobe_count: float
    lobe_radius_min: float
    lobe_radius_delta2x: float
    max_blur_size: float
    focus_point: float
    focus_scale: float
    radius_scale: float

binding material:
    color: texture_2d[float4]
    depth: texture_2d[float4]
    sampler s_tex:
        filter = .linear

struct varyings:
    @position position: hpos4
    texcoord0: float2

@pixel struct target:
    color: float4

// shaderlib.sh
fun to_gamma(rgb: float3) => pow(abs(rgb), float3(1.0 / 2.2))

// ---- bokeh_dof.sh ----

fun get_circle_of_confusion(depth: float, focus_point: float, focus_scale: float) -> float:
    // if depth is less than focusPoint, result will be negative. want to keep this
    // relationship so comparison of (signed) blur size is same as comparing depth.
    return clamp((1.0 / focus_point - 1.0 / depth) * focus_scale, -1.0, 1.0)

@pixel fun main(p: varyings){params, material} -> target:
    let tex_coord = p.texcoord0.xy

    // desaturate color to make tinted color stand out
    let mut color = material.color.sample(tex_coord, material.s_tex).xyz
    color = to_gamma(color)
    color = float3(dot(color, float3(0.33, 0.34, 0.33)))

    // get circle of confusion from depth
    let depth = material.depth.sample(tex_coord, material.s_tex).x
    let circle_of_confusion = get_circle_of_confusion(depth, params.focus_point, params.focus_scale)

    // apply tint color to debug where blur applied: foreground orange, background blue
    let mut tint_color = if circle_of_confusion < 0.0 => float3(187.0, 61.0, 7.0) / 255.0 else float3(11.0, 89.0, 138.0) / 255.0
    tint_color *= color
    color = mix(color, tint_color, abs(circle_of_confusion))

    return {
        color = float4(..color, 1.0)
    }
