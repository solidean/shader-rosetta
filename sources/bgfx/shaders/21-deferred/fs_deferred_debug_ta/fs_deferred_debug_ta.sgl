binding params:
    layer: float4

binding material:
    tex_color: texture_2d_array[float4]
    sampler s_tex:
        filter = .linear

struct varyings:
    @position position: hpos4
    texcoord0: float2

@pixel struct target:
    color: float4

@pixel fun main(p: varyings){params, material} -> target:
    // texture2DArray rounds its float layer to the nearest one
    return {
        color = material.tex_color.sample(p.texcoord0, material.s_tex, layer = round(params.layer.x) as int)
    }
