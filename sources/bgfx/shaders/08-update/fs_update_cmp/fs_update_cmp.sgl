binding material:
    tex_color: texture_2d[float4]
    sampler s_tex:
        filter = .linear

struct varyings:
    @position position: hpos4
    texcoord0: float3

@pixel struct target:
    color: float4

@pixel fun main(v: varyings){material} -> target:
    return {
        color = material.tex_color.sample(v.texcoord0.xy * 0.5 + 0.5, material.s_tex)
    }
