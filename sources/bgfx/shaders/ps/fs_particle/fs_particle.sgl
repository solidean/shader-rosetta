binding material:
    tex_color: texture_2d[float4]
    sampler s_tex:
        filter = .linear

struct varyings:
    @position position: hpos4
    color0: float4
    texcoord0: float4

@pixel struct target:
    color: float4

@pixel fun main(p: varyings){material} -> target:
    let mut rgba = material.tex_color.sample(p.texcoord0.xy, material.s_tex).xxxx

    rgba.xyz = rgba.xyz * p.color0.xyz * rgba.w * p.color0.w
    rgba.w = rgba.w * p.color0.w * (1.0 - p.texcoord0.z)
    return {
        color = rgba
    }
