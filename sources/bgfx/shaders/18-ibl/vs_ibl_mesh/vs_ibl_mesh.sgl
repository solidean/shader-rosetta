// Translated to SGL from bgfx examples/18-ibl/vs_ibl_mesh.sc.
// Copyright 2014-2016 Dario Manesku. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    model_view_proj: mat4
    model: mat4

// bgfx's u_params[12], one member per define of uniforms.sh
binding params:
    mtx0: float4
    mtx1: float4
    mtx2: float4
    mtx3: float4
    glossiness: float
    reflectivity: float
    exposure: float
    bg_type: float
    metal_or_spec: float
    unused: float3
    do_diffuse: float
    do_specular: float
    do_diffuse_ibl: float
    do_specular_ibl: float
    cam_pos: float3
    unused7: float
    rgb_diff: float4
    rgb_spec: float4
    light_dir: float3
    unused10: float
    light_col: float3
    unused11: float

@vertex struct vertex_input:
    position: pos3
    normal: float3

struct varyings:
    @position position: hpos4
    view: float3
    normal: float3

@vertex fun main(v: vertex_input){view, params} -> varyings:
    let normal = v.normal * 2.0 - 1.0
    return {
        position = view.model_view_proj * v.position
        view = params.cam_pos - (view.model * v.position).xyz
        normal = (view.model * float4(..normal, 0.0)).xyz
    }
