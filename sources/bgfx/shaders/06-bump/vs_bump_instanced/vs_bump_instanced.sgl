// Translated to SGL from bgfx examples/06-bump/vs_bump_instanced.sc.
// Copyright 2011-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    view: mat4
    view_proj: mat4

@vertex struct vertex_input:
    position: float3
    normal: float4
    tangent: float4
    texcoord0: float2
    @per_instance data0: float4
    @per_instance data1: float4
    @per_instance data2: float4
    @per_instance data3: float4

// in the order of fs_bump's, which is varying.def.sc's
struct varyings:
    @position position: hpos4
    texcoord0: float2
    wpos: float3
    view: float3
    normal: float3
    tangent: float3
    bitangent: float3

@vertex fun main(v: vertex_input){view} -> varyings:
    let model = mat4(v.data0, v.data1, v.data2, v.data3)

    let wpos = (model * float4(..v.position, 1.0)).xyz

    let normal = v.normal * 2.0 - 1.0
    let wnormal = model * vec3(..normal.xyz)

    let tangent = v.tangent * 2.0 - 1.0
    let wtangent = model * vec3(..tangent.xyz)

    let bitangent = cross(wnormal, wtangent) * tangent.w

    let tbn = mat3(float3(..wtangent), float3(..bitangent), float3(..wnormal))

    // bgfx's mul(v, m) is the row vector times the matrix
    let weyepos = (transpose(view.view) * float4(0.0, 0.0, 0.0, 1.0)).xyz
    return {
        position = view.view_proj * pos3(..wpos)
        texcoord0 = v.texcoord0
        wpos = wpos
        view = transpose(tbn) * (weyepos - wpos)
        normal = float3(..wnormal)
        tangent = float3(..wtangent)
        bitangent = float3(..bitangent)
    }
