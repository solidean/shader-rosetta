// Translated to SGL from bgfx examples/06-bump/vs_bump.sc.
// Copyright 2011-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    view: mat4
    view_proj: mat4
    model: mat4

@vertex struct vertex_input:
    position: float3
    normal: float4
    tangent: float4
    texcoord0: float2

// in the order of fs_bump's, which is varying.def.sc's
struct varyings:
    @position position: hpos4
    texcoord0: float2
    wpos: float3
    view: float3
    normal: float3
    tangent: float3
    bitangent: float3

@vertex fun main(v: vertex_input){view} -> varyings:
    let wpos = (view.model * float4(..v.position, 1.0)).xyz

    let normal = v.normal * 2.0 - 1.0
    let tangent = v.tangent * 2.0 - 1.0

    let wnormal = view.model * vec3(..normal.xyz)
    let wtangent = view.model * vec3(..tangent.xyz)

    let out_normal = normalize(wnormal)
    let out_tangent = normalize(wtangent)
    let out_bitangent = cross(out_normal, out_tangent) * tangent.w

    let tbn = mat3(float3(..out_tangent), float3(..out_bitangent), float3(..out_normal))

    // eye position in world space; bgfx's mul(v, m) is the row vector times the matrix
    let weyepos = (transpose(view.view) * float4(0.0, 0.0, 0.0, 1.0)).xyz
    return {
        position = view.view_proj * pos3(..wpos)
        texcoord0 = v.texcoord0
        wpos = wpos
        // tangent space view dir
        view = transpose(tbn) * (weyepos - wpos)
        normal = float3(..out_normal)
        tangent = float3(..out_tangent)
        bitangent = float3(..out_bitangent)
    }
