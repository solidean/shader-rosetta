binding view:
    model_view_proj: mat4

@vertex struct vertex_input:
    position: pos3

struct varyings:
    @position position: hpos4
    clip_position: float4

@vertex fun main(v: vertex_input){view} -> varyings:
    let position = view.model_view_proj * v.position
    return {
        position = position
        clip_position = position.xyzw
    }
