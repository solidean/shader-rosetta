// Translated to SGL from bgfx examples/14-shadowvolumes/vs_shadowvolume_svback.sc.
// Copyright 2013-2014 Dario Manesku. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    model_view_proj: mat4

// bgfx's u_virtualLightPos_extrusionDist, one member per define
binding params:
    virtual_light_pos: pos3
    extrusion_distance: float

@vertex struct vertex_input:
    position: pos3

struct varyings:
    @position position: hpos4

@vertex fun main(v: vertex_input){view, params} -> varyings:
    let to_light = v.position - params.virtual_light_pos
    let pos = v.position + normalize(to_light) * params.extrusion_distance
    return {
        position = view.model_view_proj * pos
    }
