struct varyings:
    @position position: hpos4

@pixel struct target:
    color: float4

// One channel per stencil step: +1, -1, +2, -2, each one count of an additive blend.
fun stencil_color(k: float) -> float4:
    return float4(
        select(abs(k - 1.0) < 0.0001, 1.0, 0.0) / 255.0,
        select(abs(k + 1.0) < 0.0001, 1.0, 0.0) / 255.0,
        select(abs(k - 2.0) < 0.0001, 1.0, 0.0) / 255.0,
        select(abs(k + 2.0) < 0.0001, 1.0, 0.0) / 255.0
    )

@pixel fun main(p: varyings, @is_front_facing front_facing: bool) -> target:
    let k = if front_facing => 1.0 else -1.0
    return {
        color = stencil_color(k)
    }
