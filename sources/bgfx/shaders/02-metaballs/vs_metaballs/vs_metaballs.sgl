binding view:
    model_view_proj: mat4
    model: mat4

@vertex struct vertex_input:
    position: pos3
    normal: float3
    color0: float4

struct varyings:
    @position position: hpos4
    normal: float3
    color0: float4

@vertex fun main(v: vertex_input){view} -> varyings:
    return {
        position = view.model_view_proj * v.position
        normal = (view.model * float4(..v.normal, 0.0)).xyz
        color0 = v.color0
    }
