// Translated to SGL from bgfx examples/46-fsr/cs_fsr_rcas_16.sc, cs_fsr.h, ffx_a.h and ffx_fsr1.h.
// Copyright 2021 Richard Schubert. BSD-2-Clause: sources/bgfx/LICENSE.
// ffx_a.h and ffx_fsr1.h, AMD FidelityFX FSR 1: Copyright (c) 2021 Advanced Micro Devices, Inc. MIT: sources/bgfx/upstream/examples/46-fsr/ffx_fsr1.h.

// SAMPLE_HALF_MATH, which every target but GLSL compiles: the 16-bit math, into an rgba16f image
require shader_f16

// bgfx's u_params[3], one member per define of cs_fsr.h
binding params:
    viewport_size_rcas_attenuation: float4
    src_size: float4
    dst_size: float4

binding fsr:
    input_texture: texture_2d[float4]
    output_texture: out image_2d[.rgba16_float]

// ffx_a.h
fun rcp(x: half) => 1.0 / x

// gap: a half has no `.bits` and no `half.from_bits`, and no bit operator takes a ushort, so its bits travel in a uint
fun half_bits(a: half) => pack_half2x16(float2(a as float, 0.0))

// gap: the stand-in's way back, from the low 16 bits of a uint
fun half_from_bits(u: uint) => unpack_half2x16(u).x as half

fun prx_med_rcp(a: half) -> half:
    let b = half_from_bits(0x778du - half_bits(a))
    return b * (-b * a + 2.0)

fun min3(x: half, y: half, z: half) => min(x, min(y, z))

fun max3(x: half, y: half, z: half) => max(x, max(y, z))

fun bfe(src: uint, off: uint, bits: uint) -> uint:
    let mask = (1u << bits) - 1u
    return (src >> off) & mask

fun bfi_m(src: uint, ins: uint, bits: uint) -> uint:
    let mask = (1u << bits) - 1u
    return (ins & mask) | (src & (~mask))

// Remap the lane index of a 64-wide workgroup to an 8x8 tile, in a pixel-shader-like swizzle.
fun rmp8x8(a: uint) => uint2(bfe(a, 1u, 3u), bfi_m(bfe(a, 3u, 3u), a, 1u))

// This is set at the limit of providing unnatural results for sharpening.
const fsr_rcas_limit = 0.25 - (1.0 / 16.0)

// Call to setup required constant values (works on CPU or GPU).
fun fsr_rcas_con(
    // The scale is {0.0 := maximum, to N>0, where N is the number of stops (halving) of the reduction of sharpness}.
    sharpness: float
) -> uint4:
    // Transform from stops to linear value.
    let sharpness = exp2(-sharpness)
    let h_sharp = float2(sharpness, sharpness)
    return uint4(sharpness.bits, pack_half2x16(h_sharp), 0u, 0u)

// cs_fsr.h's input callback; its FsrRcasInputH, the optional input transform, is empty
fun fsr_rcas_load(p: int2){fsr} -> half4 => fsr.input_texture.load(p, 0) as half4

fun fsr_rcas(
    // Integer pixel position in output.
    ip: uint2
    // Constant generated by RcasSetup().
    con: uint4
){fsr} -> half3:
    // Sharpening algorithm uses minimal 3x3 pixel neighborhood.
    //    b
    //  d e f
    //    h
    // ffx_fsr1.h makes this an ASW2, min16int2, a precision hint; an int2 needs no shader_int16, which WebGPU lacks
    let sp = ip as int2
    let b = fsr_rcas_load(sp + int2(0, -1)).rgb
    let d = fsr_rcas_load(sp + int2(-1, 0)).rgb
    let e = fsr_rcas_load(sp).rgb
    let f = fsr_rcas_load(sp + int2(1, 0)).rgb
    let h = fsr_rcas_load(sp + int2(0, 1)).rgb
    // Rename (32-bit) or regroup (16-bit).
    let b_r = b.r
    let b_g = b.g
    let b_b = b.b
    let d_r = d.r
    let d_g = d.g
    let d_b = d.b
    let e_r = e.r
    let e_g = e.g
    let e_b = e.b
    let f_r = f.r
    let f_g = f.g
    let f_b = f.b
    let h_r = h.r
    let h_g = h.g
    let h_b = h.b
    // Luma times 2.
    let b_l = b_b * 0.5 + (b_r * 0.5 + b_g)
    let d_l = d_b * 0.5 + (d_r * 0.5 + d_g)
    let e_l = e_b * 0.5 + (e_r * 0.5 + e_g)
    let f_l = f_b * 0.5 + (f_r * 0.5 + f_g)
    let h_l = h_b * 0.5 + (h_r * 0.5 + h_g)
    // Noise detection.
    let mut nz = 0.25 * b_l + 0.25 * d_l + 0.25 * f_l + 0.25 * h_l - e_l
    nz = saturate(abs(nz) * prx_med_rcp(max3(max3(b_l, d_l, e_l), f_l, h_l) - min3(min3(b_l, d_l, e_l), f_l, h_l)))
    nz = -0.5 * nz + 1.0
    // Min and max of ring.
    let mn4_r = min(min3(b_r, d_r, f_r), h_r)
    let mn4_g = min(min3(b_g, d_g, f_g), h_g)
    let mn4_b = min(min3(b_b, d_b, f_b), h_b)
    let mx4_r = max(max3(b_r, d_r, f_r), h_r)
    let mx4_g = max(max3(b_g, d_g, f_g), h_g)
    let mx4_b = max(max3(b_b, d_b, f_b), h_b)
    // Immediate constants for peak range.
    let peak_c = half2(1.0, half(-1.0 * 4.0))
    // Limiters, these need to be high precision RCPs.
    let hit_min_r = mn4_r * rcp(4.0 * mx4_r)
    let hit_min_g = mn4_g * rcp(4.0 * mx4_g)
    let hit_min_b = mn4_b * rcp(4.0 * mx4_b)
    let hit_max_r = (peak_c.x - mx4_r) * rcp(4.0 * mn4_r + peak_c.y)
    let hit_max_g = (peak_c.x - mx4_g) * rcp(4.0 * mn4_g + peak_c.y)
    let hit_max_b = (peak_c.x - mx4_b) * rcp(4.0 * mn4_b + peak_c.y)
    let lobe_r = max(-hit_min_r, hit_max_r)
    let lobe_g = max(-hit_min_g, hit_max_g)
    let lobe_b = max(-hit_min_b, hit_max_b)
    let lobe = max(half(-fsr_rcas_limit), min(max3(lobe_r, lobe_g, lobe_b), 0.0)) * (unpack_half2x16(con.y).x as half)
    // Resolve, which needs the medium precision rcp approximation to avoid visible tonality changes.
    let rcp_l = prx_med_rcp(4.0 * lobe + 1.0)
    return half3(
        (lobe * b_r + lobe * d_r + lobe * h_r + lobe * f_r + e_r) * rcp_l
        (lobe * b_g + lobe * d_g + lobe * h_g + lobe * f_g + e_g) * rcp_l
        (lobe * b_b + lobe * d_b + lobe * h_b + lobe * f_b + e_b) * rcp_l
    )

fun curr_filter(pos: uint2, con0: uint4, sample_flags: uint4){fsr}:
    let mut c = fsr_rcas(pos, con0)
    if sample_flags.x == 1u => c *= c
    fsr.output_texture[pos as int2] = (half4(..c, 1.0) as float4) as texel[.rgba16_float]

@compute(64, 1, 1) fun main(@local_thread_id local_id: int3, @workgroup_id group_id: int3){params, fsr}:
    // We compute these constants on GPU because bgfx does not support uniform type uint.
    let con0 = fsr_rcas_con(params.viewport_size_rcas_attenuation.z)
    // no HDR output; only its x is read
    let sample_flags = uint4(0u)

    // Do remapping of local xy in workgroup for a more PS-like swizzle pattern.
    let mut gxy = rmp8x8(local_id.x as uint) + uint2((group_id.x as uint) << 4u, (group_id.y as uint) << 4u)
    curr_filter(gxy, con0, sample_flags)
    gxy.x += 8u
    curr_filter(gxy, con0, sample_flags)
    gxy.y += 8u
    curr_filter(gxy, con0, sample_flags)
    gxy.x -= 8u
    curr_filter(gxy, con0, sample_flags)
