// Copyright 2011-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    model_view_proj: mat4
    model_view: mat4

binding params:
    time: float

@vertex struct vertex_input:
    position: float3
    normal: float3

struct varyings:
    @position position: hpos4
    pos: float3
    view: float3
    normal: float3
    color0: float4

@vertex fun main(v: vertex_input){view, params} -> varyings:
    let sx = sin(v.position.x * 32.0 + params.time * 4.0) * 0.5 + 0.5
    let cy = cos(v.position.y * 32.0 + params.time * 4.0) * 0.5 + 0.5
    let displacement = float3(sx, cy, sx * cy)
    let normal = v.normal * 2.0 - 1.0

    let pos = v.position + normal * displacement * float3(0.06, 0.06, 0.06)

    let position = view.model_view_proj * pos3(..pos)
    let len = length(displacement) * 0.4 + 0.6
    return {
        position = position
        pos = position.xyz
        view = (view.model_view * float4(..pos, 1.0)).xyz
        normal = (view.model_view * float4(..normal, 0.0)).xyz
        color0 = float4(len, len, len, 1.0)
    }
