@vertex struct vertex_input:
    position: float3

struct varyings:
    @position position: hpos4
    texcoord0: float2

@vertex fun main(v: vertex_input) -> varyings:
    return {
        position = hpos4(..v.position.xy, 1.0, 1.0)
        texcoord0 = v.position.xy
    }
