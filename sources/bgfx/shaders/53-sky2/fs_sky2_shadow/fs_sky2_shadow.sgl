struct varyings:
    @position position: hpos4
    shadowcoord: float4

@pixel struct target:
    color: float4

@pixel fun main(p: varyings) -> target:
    return {
        color = float4(p.shadowcoord.z / p.shadowcoord.w, 0.0, 0.0, 1.0)
    }
