// The original carries no copyright line; bgfx: Copyright 2010-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    model_view_proj: mat4

// bgfx declares a vec4 and reads only its xyz
@vertex struct vertex_input:
    position: pos3
    texcoord0: float2

struct varyings:
    @position position: hpos4
    texcoord0: float2

@vertex fun main(v: vertex_input){view} -> varyings:
    return {
        position = view.model_view_proj * v.position
        texcoord0 = v.texcoord0
    }
