// the depth format of uniforms.sh, r16f, is outside the portable image formats
require extended_image_formats

// bgfx's u_params[19], one member per define of uniforms.sh, and u_rect
binding params:
    viewport_pixel_size: float2
    half_viewport_pixel_size: float2
    depth_unpack_consts: float2
    unused1: float2
    ndc_to_view_mul: float2
    ndc_to_view_add: float2
    per_pass_full_res_coord_offset: float2
    per_pass_full_res_uv_offset: float2
    viewport_2x_pixel_size: float2
    viewport_2x_pixel_size_x_025: float2
    effect_radius: float
    effect_shadow_strength: float
    effect_shadow_pow: float
    effect_shadow_clamp: float
    effect_fade_out_mul: float
    effect_fade_out_add: float
    effect_horizon_angle_threshold: float
    effect_sampling_radius_near_limit_rec: float
    depth_precision_offset_mod: float
    neg_rec_effect_radius: float
    load_counter_avg_div: float
    adaptive_sample_count_limit: float
    inv_sharpness: float
    pass_index: float
    quarter_res_pixel_size: float2
    pattern_rot_scale_matrices: float4[5]
    normals_unpack_mul: float
    normals_unpack_add: float
    detail_ao_strength: float
    layer: float
    normals_world_to_viewspace_matrix0: float4
    normals_world_to_viewspace_matrix1: float4
    normals_world_to_viewspace_matrix2: float4
    normals_world_to_viewspace_matrix3: float4
    rect: float4

binding depths:
    depth_source: texture_2d[float4]
    sampler s_depth_source:
        filter = .linear
    target0: out image_2d[.r16_float]
    target1: out image_2d[.r16_float]
    target2: out image_2d[.r16_float]
    target3: out image_2d[.r16_float]
    normals_output_uav: out image_2d[.rgba8_unorm]

fun screen_space_to_view_space_depth(screen_depth: float){params} -> float:
    let depth_linearize_mul = params.depth_unpack_consts.x
    let depth_linearize_add = params.depth_unpack_consts.y

    // Optimised version of "-cameraClipNear / (cameraClipFar - projDepth * (cameraClipFar - cameraClipNear)) * cameraClipFar"

    // Set your depthLinearizeMul and depthLinearizeAdd to:
    // depthLinearizeMul = ( cameraClipFar * cameraClipNear) / ( cameraClipFar - cameraClipNear );
    // depthLinearizeAdd = cameraClipFar / ( cameraClipFar - cameraClipNear );

    return depth_linearize_mul / (depth_linearize_add - screen_depth)

fun ndc_to_viewspace(pos: float2, viewspace_depth: float){params} -> pos3:
    return pos3(..((params.ndc_to_view_mul * pos.xy + params.ndc_to_view_add) * viewspace_depth), viewspace_depth)

fun calculate_edges(center_z: float, left_z: float, right_z: float, top_z: float, bottom_z: float) -> float4:
    // slope-sensitive depth-based edge detection
    let mut edges_lrtb = float4(left_z, right_z, top_z, bottom_z) - center_z
    let edges_lrtb_slope_adjusted = edges_lrtb + edges_lrtb.yxwz
    edges_lrtb = min(abs(edges_lrtb), abs(edges_lrtb_slope_adjusted))
    return saturate(1.3 - edges_lrtb / (center_z * 0.040))

    // cheaper version but has artifacts
    // edgesLRTB = abs( vec4( leftZ, rightZ, topZ, bottomZ ) - centerZ; );
    // return saturate( ( 1.3 - edgesLRTB / (pixZ * 0.06 + 0.1) ) );

fun calculate_normal(edges_lrtb: float4, pix_center_pos: pos3, pix_l_pos: pos3, pix_r_pos: pos3, pix_t_pos: pos3, pix_b_pos: pos3) -> vec3:
    // Get this pixel's viewspace normal
    let accepted_normals = float4(
        edges_lrtb.x * edges_lrtb.z
        edges_lrtb.z * edges_lrtb.y
        edges_lrtb.y * edges_lrtb.w
        edges_lrtb.w * edges_lrtb.x
    )

    let pix_l_dir = normalize(pix_l_pos - pix_center_pos)
    let pix_r_dir = normalize(pix_r_pos - pix_center_pos)
    let pix_t_dir = normalize(pix_t_pos - pix_center_pos)
    let pix_b_dir = normalize(pix_b_pos - pix_center_pos)

    let mut pixel_normal = vec3(0.0, 0.0, -0.0005)
    pixel_normal += accepted_normals.x * cross(pix_l_dir, pix_t_dir)
    pixel_normal += accepted_normals.y * cross(pix_t_dir, pix_r_dir)
    pixel_normal += accepted_normals.z * cross(pix_r_dir, pix_b_dir)
    pixel_normal += accepted_normals.w * cross(pix_b_dir, pix_l_dir)
    pixel_normal = normalize(pixel_normal)

    return pixel_normal

@compute(8, 8, 1) fun main(@thread_id id: int3){params, depths}:
    let dt_id = id.xy as uint2

    let dim = depths.target0.size() as uint2
    if all(dt_id < dim):
        let base_coords = (dt_id as int2) * 2
        let upper_left_uv = ((dt_id as float2) + float2(0.25, 0.25)) * params.viewport_2x_pixel_size

        let base_coord = (dt_id as int2) * 2
        let z0 = screen_space_to_view_space_depth(depths.depth_source.load(base_coord + int2(0, 0), 0).x)
        let z1 = screen_space_to_view_space_depth(depths.depth_source.load(base_coord + int2(1, 0), 0).x)
        let z2 = screen_space_to_view_space_depth(depths.depth_source.load(base_coord + int2(0, 1), 0).x)
        let z3 = screen_space_to_view_space_depth(depths.depth_source.load(base_coord + int2(1, 1), 0).x)
        depths.target0[dt_id as int2] = z0
        depths.target1[dt_id as int2] = z1
        depths.target2[dt_id as int2] = z2
        depths.target3[dt_id as int2] = z3

        let mut pix_zs = float[4, 4].filled(float[4].filled(0.0))

        // middle 4
        pix_zs[1, 1] = z0
        pix_zs[2, 1] = z1
        pix_zs[1, 2] = z2
        pix_zs[2, 2] = z3

        // left 2
        pix_zs[0, 1] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(-1, 0)).x)
        pix_zs[0, 2] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(-1, 1)).x)
        // right 2
        pix_zs[3, 1] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(2, 0)).x)
        pix_zs[3, 2] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(2, 1)).x)
        // top 2
        pix_zs[1, 0] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(0, -1)).x)
        pix_zs[2, 0] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(1, -1)).x)
        // bottom 2
        pix_zs[1, 3] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(0, 2)).x)
        pix_zs[2, 3] = screen_space_to_view_space_depth(depths.depth_source.sample(upper_left_uv, depths.s_depth_source, level = 0.0, offset = int2(1, 2)).x)

        let edges0 = calculate_edges(pix_zs[1, 1], pix_zs[0, 1], pix_zs[2, 1], pix_zs[1, 0], pix_zs[1, 2])
        let edges1 = calculate_edges(pix_zs[2, 1], pix_zs[1, 1], pix_zs[3, 1], pix_zs[2, 0], pix_zs[2, 2])
        let edges2 = calculate_edges(pix_zs[1, 2], pix_zs[0, 2], pix_zs[2, 2], pix_zs[1, 1], pix_zs[1, 3])
        let edges3 = calculate_edges(pix_zs[2, 2], pix_zs[1, 2], pix_zs[3, 2], pix_zs[2, 1], pix_zs[2, 3])

        let viewport_pixel_size = params.viewport_pixel_size

        let mut pix_pos = pos3[4, 4].filled(pos3[4].filled(pos3(0.0)))
        // middle 4
        pix_pos[1, 1] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(0.0, 0.0), pix_zs[1, 1])
        pix_pos[2, 1] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(1.0, 0.0), pix_zs[2, 1])
        pix_pos[1, 2] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(0.0, 1.0), pix_zs[1, 2])
        pix_pos[2, 2] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(1.0, 1.0), pix_zs[2, 2])
        // left 2
        pix_pos[0, 1] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(-1.0, 0.0), pix_zs[0, 1])
        pix_pos[0, 2] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(-1.0, 1.0), pix_zs[0, 2])
        // right 2
        pix_pos[3, 1] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(2.0, 0.0), pix_zs[3, 1])
        pix_pos[3, 2] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(2.0, 1.0), pix_zs[3, 2])
        // top 2
        pix_pos[1, 0] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(0.0, -1.0), pix_zs[1, 0])
        pix_pos[2, 0] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(1.0, -1.0), pix_zs[2, 0])
        // bottom 2
        pix_pos[1, 3] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(0.0, 2.0), pix_zs[1, 3])
        pix_pos[2, 3] = ndc_to_viewspace(upper_left_uv + viewport_pixel_size * float2(1.0, 2.0), pix_zs[2, 3])

        let norm0 = calculate_normal(edges0, pix_pos[1, 1], pix_pos[0, 1], pix_pos[2, 1], pix_pos[1, 0], pix_pos[1, 2])
        let norm1 = calculate_normal(edges1, pix_pos[2, 1], pix_pos[1, 1], pix_pos[3, 1], pix_pos[2, 0], pix_pos[2, 2])
        let norm2 = calculate_normal(edges2, pix_pos[1, 2], pix_pos[0, 2], pix_pos[2, 2], pix_pos[1, 1], pix_pos[1, 3])
        let norm3 = calculate_normal(edges3, pix_pos[2, 2], pix_pos[1, 2], pix_pos[3, 2], pix_pos[2, 1], pix_pos[2, 3])

        depths.normals_output_uav[base_coords + int2(0, 0)] = float4(..(float3(..norm0) * 0.5 + 0.5), 0.0)
        depths.normals_output_uav[base_coords + int2(1, 0)] = float4(..(float3(..norm1) * 0.5 + 0.5), 0.0)
        depths.normals_output_uav[base_coords + int2(0, 1)] = float4(..(float3(..norm2) * 0.5 + 0.5), 0.0)
        depths.normals_output_uav[base_coords + int2(1, 1)] = float4(..(float3(..norm3) * 0.5 + 0.5), 0.0)
