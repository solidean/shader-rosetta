// Translated to SGL from bgfx examples/39-assao/cs_assao_postprocess_importance_map_b.sc.
// Copyright 2018 Attila Kocsis. BSD-2-Clause: sources/bgfx/LICENSE.

// the ao format of uniforms.sh, r8, is outside the portable image formats
require extended_image_formats

// bgfx's u_params[19], one member per define of uniforms.sh, and u_rect
binding params:
    viewport_pixel_size: float2
    half_viewport_pixel_size: float2
    depth_unpack_consts: float2
    unused1: float2
    ndc_to_view_mul: float2
    ndc_to_view_add: float2
    per_pass_full_res_coord_offset: float2
    per_pass_full_res_uv_offset: float2
    viewport_2x_pixel_size: float2
    viewport_2x_pixel_size_x_025: float2
    effect_radius: float
    effect_shadow_strength: float
    effect_shadow_pow: float
    effect_shadow_clamp: float
    effect_fade_out_mul: float
    effect_fade_out_add: float
    effect_horizon_angle_threshold: float
    effect_sampling_radius_near_limit_rec: float
    depth_precision_offset_mod: float
    neg_rec_effect_radius: float
    load_counter_avg_div: float
    adaptive_sample_count_limit: float
    inv_sharpness: float
    pass_index: float
    quarter_res_pixel_size: float2
    pattern_rot_scale_matrices: float4[5]
    normals_unpack_mul: float
    normals_unpack_add: float
    detail_ao_strength: float
    layer: float
    normals_world_to_viewspace_matrix0: float4
    normals_world_to_viewspace_matrix1: float4
    normals_world_to_viewspace_matrix2: float4
    normals_world_to_viewspace_matrix3: float4
    rect: float4

binding importance:
    target: out image_2d[.r8_unorm]
    importance_map: texture_2d[float4]
    sampler s_importance_map:
        filter = .linear
    load_counter: mut buffer[atomic[uint]]

const c_smoothen_importance = 1.0

// Shaders below only needed for adaptive quality level
@compute(8, 8, 1) fun main(@thread_id id: int3){params, importance}:
    let dt_id = id.xy as uint2

    let dim = importance.target.size() as uint2
    if all(dt_id < dim):
        let in_uv = ((dt_id as float2) + float2(0.5, 0.5)) * params.quarter_res_pixel_size

        let centre = importance.importance_map.sample(in_uv, importance.s_importance_map, level = 0.0).x
        // return centre;

        let half_pixel = params.quarter_res_pixel_size * 0.5

        let mut vals = float4(
            importance.importance_map.sample(in_uv + float2(-half_pixel.x, -half_pixel.y * 3.0), importance.s_importance_map, level = 0.0).x
            importance.importance_map.sample(in_uv + float2(half_pixel.x * 3.0, -half_pixel.y), importance.s_importance_map, level = 0.0).x
            importance.importance_map.sample(in_uv + float2(half_pixel.x, half_pixel.y * 3.0), importance.s_importance_map, level = 0.0).x
            importance.importance_map.sample(in_uv + float2(-half_pixel.x * 3.0, half_pixel.y), importance.s_importance_map, level = 0.0).x
        )

        let avg_val = dot(vals, float4(0.25, 0.25, 0.25, 0.25))
        vals.xy = max(vals.xy, vals.zw)
        let max_val = max(centre, max(vals.x, vals.y))

        let ret_val = mix(max_val, avg_val, c_smoothen_importance)

        // sum the average; to avoid overflowing we assume max AO resolution is not bigger than 16384x16384; so quarter res (used here) will be 4096x4096, which leaves us with 8 bits per pixel
        let sum = (saturate(ret_val) * 255.0 + 0.5) as uint

        // save every 9th to avoid InterlockedAdd congestion - since we're blurring, this is good enough; compensated by multiplying LoadCounterAvgDiv by 9
        if (dt_id.x % 3u) + (dt_id.y % 3u) == 0u:
            importance.load_counter[0].add(sum)
        importance.target[dt_id as int2] = ret_val
