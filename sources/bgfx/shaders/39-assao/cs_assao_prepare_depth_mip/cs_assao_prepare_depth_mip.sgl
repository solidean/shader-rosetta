// the depth format of uniforms.sh, r16f, is outside the portable image formats
require extended_image_formats

// bgfx's u_params[19], one member per define of uniforms.sh, and u_rect
binding params:
    viewport_pixel_size: float2
    half_viewport_pixel_size: float2
    depth_unpack_consts: float2
    unused1: float2
    ndc_to_view_mul: float2
    ndc_to_view_add: float2
    per_pass_full_res_coord_offset: float2
    per_pass_full_res_uv_offset: float2
    viewport_2x_pixel_size: float2
    viewport_2x_pixel_size_x_025: float2
    effect_radius: float
    effect_shadow_strength: float
    effect_shadow_pow: float
    effect_shadow_clamp: float
    effect_fade_out_mul: float
    effect_fade_out_add: float
    effect_horizon_angle_threshold: float
    effect_sampling_radius_near_limit_rec: float
    depth_precision_offset_mod: float
    neg_rec_effect_radius: float
    load_counter_avg_div: float
    adaptive_sample_count_limit: float
    inv_sharpness: float
    pass_index: float
    quarter_res_pixel_size: float2
    pattern_rot_scale_matrices: float4[5]
    normals_unpack_mul: float
    normals_unpack_add: float
    detail_ao_strength: float
    layer: float
    normals_world_to_viewspace_matrix0: float4
    normals_world_to_viewspace_matrix1: float4
    normals_world_to_viewspace_matrix2: float4
    normals_world_to_viewspace_matrix3: float4
    rect: float4

binding depths:
    viewspace_depth_source0: image_2d[.r16_float]
    viewspace_depth_source1: image_2d[.r16_float]
    viewspace_depth_source2: image_2d[.r16_float]
    viewspace_depth_source3: image_2d[.r16_float]
    target0: out image_2d[.r16_float]
    target1: out image_2d[.r16_float]
    target2: out image_2d[.r16_float]
    target3: out image_2d[.r16_float]

struct radius_parameters:
    pix_lookup_radius_mod: float
    effect_radius: float
    falloff_calc_mul_sq: float

// calculate effect radius and fit our screen sampling pattern inside it
fun calculate_radius_parameters(pix_center_length: float, pixel_dir_rb_viewspace_size_at_center_z: float2){params} -> radius_parameters:
    let mut effect_radius = params.effect_radius

    // leaving this out for performance reasons: use something similar if radius needs to scale based on distance
    // effectRadius *= pow( pixCenterLength, u_radiusDistanceScalingFunctionPow);

    // when too close, on-screen sampling disk will grow beyond screen size; limit this to avoid closeup temporal artifacts
    let too_close_limit_mod = saturate(pix_center_length * params.effect_sampling_radius_near_limit_rec) * 0.8 + 0.2

    effect_radius *= too_close_limit_mod

    return {
        // 0.85 is to reduce the radius to allow for more samples on a slope to still stay within influence
        pix_lookup_radius_mod = (0.85 * effect_radius) / pixel_dir_rb_viewspace_size_at_center_z.x
        effect_radius = effect_radius
        // used to calculate falloff (both for AO samples and per-sample weights)
        falloff_calc_mul_sq = -1.0 / (effect_radius * effect_radius)
    }

@compute(8, 8, 1) fun main(@thread_id id: int3){params, depths}:
    let dt_id = id.xy as uint2

    let dim = params.rect.zw as uint2
    if all(dt_id < dim):
        let base_coords = (dt_id as int2) * 2

        // how to Gather a specific mip level?
        let depths_arr = [
            float4(
                depths.viewspace_depth_source0[base_coords + int2(0, 0)]
                depths.viewspace_depth_source0[base_coords + int2(1, 0)]
                depths.viewspace_depth_source0[base_coords + int2(0, 1)]
                depths.viewspace_depth_source0[base_coords + int2(1, 1)]
            )
            float4(
                depths.viewspace_depth_source1[base_coords + int2(0, 0)]
                depths.viewspace_depth_source1[base_coords + int2(1, 0)]
                depths.viewspace_depth_source1[base_coords + int2(0, 1)]
                depths.viewspace_depth_source1[base_coords + int2(1, 1)]
            )
            float4(
                depths.viewspace_depth_source2[base_coords + int2(0, 0)]
                depths.viewspace_depth_source2[base_coords + int2(1, 0)]
                depths.viewspace_depth_source2[base_coords + int2(0, 1)]
                depths.viewspace_depth_source2[base_coords + int2(1, 1)]
            )
            float4(
                depths.viewspace_depth_source3[base_coords + int2(0, 0)]
                depths.viewspace_depth_source3[base_coords + int2(1, 0)]
                depths.viewspace_depth_source3[base_coords + int2(0, 1)]
                depths.viewspace_depth_source3[base_coords + int2(1, 1)]
            )
        ]
        let mut depths_out_arr = float[4].filled(0.0)

        let sv_pos_ui = dt_id.xy
        let pseudo_random_a = sv_pos_ui.x + 2u * sv_pos_ui.y

        @unroll
        for i in 0 ..< 4:
            let depths_i = depths_arr[i]
            let closest = min(min(depths_i.x, depths_i.y), min(depths_i.z, depths_i.w))

            let falloff_calc_mul_sq = calculate_radius_parameters(abs(closest), float2(1.0, 1.0)).falloff_calc_mul_sq

            let dists = depths_i - float4(closest)

            let weights = saturate(dists * dists * falloff_calc_mul_sq + 1.0)

            let smart_avg = dot(weights, depths_i) / dot(weights, float4(1.0, 1.0, 1.0, 1.0))

            let pseudo_random_index = (pseudo_random_a + (i as uint)) % 4u

            // depthsOutArr[i] = closest;
            // depthsOutArr[i] = depths[ pseudoRandomIndex ];
            depths_out_arr[i] = smart_avg

        depths.target0[dt_id as int2] = depths_out_arr[0]
        depths.target1[dt_id as int2] = depths_out_arr[1]
        depths.target2[dt_id as int2] = depths_out_arr[2]
        depths.target3[dt_id as int2] = depths_out_arr[3]
