// the ao format of uniforms.sh, r8, is outside the portable image formats
require extended_image_formats

// bgfx's u_params[19], one member per define of uniforms.sh, and u_rect
binding params:
    viewport_pixel_size: float2
    half_viewport_pixel_size: float2
    depth_unpack_consts: float2
    unused1: float2
    ndc_to_view_mul: float2
    ndc_to_view_add: float2
    per_pass_full_res_coord_offset: float2
    per_pass_full_res_uv_offset: float2
    viewport_2x_pixel_size: float2
    viewport_2x_pixel_size_x_025: float2
    effect_radius: float
    effect_shadow_strength: float
    effect_shadow_pow: float
    effect_shadow_clamp: float
    effect_fade_out_mul: float
    effect_fade_out_add: float
    effect_horizon_angle_threshold: float
    effect_sampling_radius_near_limit_rec: float
    depth_precision_offset_mod: float
    neg_rec_effect_radius: float
    load_counter_avg_div: float
    adaptive_sample_count_limit: float
    inv_sharpness: float
    pass_index: float
    quarter_res_pixel_size: float2
    pattern_rot_scale_matrices: float4[5]
    normals_unpack_mul: float
    normals_unpack_add: float
    detail_ao_strength: float
    layer: float
    normals_world_to_viewspace_matrix0: float4
    normals_world_to_viewspace_matrix1: float4
    normals_world_to_viewspace_matrix2: float4
    normals_world_to_viewspace_matrix3: float4
    rect: float4

binding ssao:
    target: out image_2d[.r8_unorm]
    final_ssao: texture_2d_array[float4]
    sampler s_final_ssao:
        filter = .linear

@compute(8, 8, 1) fun main(@thread_id id: int3){params, ssao}:
    let dt_id = id.xy as uint2

    let dim = ssao.target.size() as uint2
    if all(dt_id < dim):
        let base_pos = dt_id * 2u

        let base_uv = ((base_pos as float2) + float2(0.5, 0.5)) * params.half_viewport_pixel_size
        let gather_uv = ((base_pos as float2) + float2(1.0, 1.0)) * params.half_viewport_pixel_size

        let mut avg = 0.0
        let mut min_v = 1.0
        let mut max_v = 0.0
        @unroll
        for i in 0 ..< 4:
            let mut vals = ssao.final_ssao.gather(gather_uv, ssao.s_final_ssao, layer = i)

            // apply the same modifications that would have been applied in the main shader
            vals = params.effect_shadow_strength * vals

            vals = 1.0 - vals

            vals = pow(saturate(vals), float4(params.effect_shadow_pow))

            avg += dot(float4(vals.x, vals.y, vals.z, vals.w), float4(1.0 / 16.0, 1.0 / 16.0, 1.0 / 16.0, 1.0 / 16.0))

            max_v = max(max_v, max(max(vals.x, vals.y), max(vals.z, vals.w)))
            min_v = min(min_v, min(min(vals.x, vals.y), min(vals.z, vals.w)))

        let min_max_diff = max_v - min_v

        ssao.target[dt_id as int2] = pow(saturate(min_max_diff * 2.0), 0.8)
