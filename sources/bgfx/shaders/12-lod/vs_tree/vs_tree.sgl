binding view:
    model_view_proj: mat4
    model_view: mat4

@vertex struct vertex_input:
    position: pos3
    normal: float3
    texcoord0: float2

// in varying.def.sc's order, which fs_tree's matches
struct varyings:
    @position position: hpos4
    normal: float3
    texcoord0: float2
    pos: float3
    view: float3

@vertex fun main(v: vertex_input){view} -> varyings:
    let normal = v.normal * 2.0 - 1.0

    let position = view.model_view_proj * v.position
    return {
        position = position
        normal = (view.model_view * float4(..normal, 0.0)).xyz
        texcoord0 = v.texcoord0
        pos = position.xyz / position.w
        view = (view.model_view * v.position).xyz
    }
