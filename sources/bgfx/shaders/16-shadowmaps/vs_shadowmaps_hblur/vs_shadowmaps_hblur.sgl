// Translated to SGL from bgfx examples/16-shadowmaps/vs_shadowmaps_hblur.sc.
// Copyright 2011-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    view_texel: float4
    model_view_proj: mat4

binding params:
    // u_smSamplingParams; z is the horizontal offset
    sm_sampling_params: float4

@vertex struct vertex_input:
    position: pos3
    texcoord0: float2

struct varyings:
    @position position: hpos4
    texcoord0: float2
    texcoord1: float4
    texcoord2: float4
    texcoord3: float4
    texcoord4: float4

@vertex fun main(v: vertex_input){view, params} -> varyings:
    let offset = view.view_texel.x * params.sm_sampling_params.z
    let uv = v.texcoord0
    return {
        position = view.model_view_proj * v.position
        texcoord0 = uv
        texcoord1 = float4(uv.x - offset * 1.0, uv.y, uv.x + offset * 1.0, uv.y)
        texcoord2 = float4(uv.x - offset * 2.0, uv.y, uv.x + offset * 2.0, uv.y)
        texcoord3 = float4(uv.x - offset * 3.0, uv.y, uv.x + offset * 3.0, uv.y)
        texcoord4 = float4(uv.x - offset * 4.0, uv.y, uv.x + offset * 4.0, uv.y)
    }
