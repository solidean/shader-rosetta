struct varyings:
    @position position: hpos4
    pos: float4

@pixel struct target:
    color: float4

fun pack_float_to_rgba(value: float) -> float4:
    let shift = float4(255.0 * 255.0 * 255.0, 255.0 * 255.0, 255.0, 1.0)
    let mask = float4(0.0, 1.0 / 255.0, 1.0 / 255.0, 1.0 / 255.0)
    let mut comp = fract(value * shift)
    comp -= comp.xxyz * mask
    return comp

@pixel fun main(p: varyings) -> target:
    let depth = p.pos.z / p.pos.w * 0.5 + 0.5
    return {
        color = pack_float_to_rgba(depth)
    }
