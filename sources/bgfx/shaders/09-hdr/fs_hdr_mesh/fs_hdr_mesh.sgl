// Translated to SGL from bgfx examples/09-hdr/fs_hdr_mesh.sc.
// Copyright 2011-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

// bgfx's M_PI
const pi = 3.1415926535897932384626433832795

binding params:
    middle_gray: float
    white_sqr: float
    threshold: float
    time: float

binding material:
    tex_cube: texture_cube[float4]
    sampler s_tex:
        filter = .linear

struct varyings:
    @position position: hpos4
    pos: float3
    view: vec3
    normal: vec3

@pixel struct target:
    color: float4

fun blinn(light_dir: vec3, normal: vec3, view_dir: vec3) -> float2:
    let ndotl = dot(normal, light_dir)
    // reflect(light_dir, normal)
    let reflected = light_dir - 2.0 * ndotl * normal
    let rdotv = dot(reflected, view_dir)
    return float2(ndotl, rdotv)

fun fresnel(ndotl: float, bias: float, power: float) -> float:
    let facing = 1.0 - ndotl
    return max(bias + (1.0 - bias) * pow(facing, power), 0.0)

fun lit(ndotl: float, rdotv: float, m: float) -> float4:
    let diff = max(0.0, ndotl)
    let spec = step(0.0, ndotl) * max(0.0, rdotv * m)
    return float4(1.0, diff, spec, 1.0)

fun encode_rgbe8(rgb: float3) -> float4:
    let max_component = max(max(rgb.x, rgb.y), rgb.z)
    let exponent = ceil(log2(max_component))
    return float4(..(rgb / exp2(exponent)), (exponent + 128.0) / 255.0)

@pixel fun main(p: varyings){params, material} -> target:
    let light_dir = vec3(0.0, 0.0, -1.0)
    let normal = normalize(p.normal)
    let view = normalize(p.view)
    let bln = blinn(light_dir, normal, view)
    let lc = lit(bln.x, bln.y, 1.0)
    let fres = fresnel(bln.x, 0.2, 5.0)

    let index = ((sin(p.pos.x * 3.0 + params.time) * 0.3 + 0.7) + (cos(p.pos.y * 3.0 + params.time) * 0.4 + 0.6) + (cos(p.pos.z * 3.0 + params.time) * 0.2 + 0.8)) * pi

    let mut color = float3(sin(index * 8.0) * 0.4 + 0.6, sin(index * 4.0) * 0.4 + 0.6, sin(index * 2.0) * 0.4 + 0.6)

    color *= material.tex_cube.sample(reflect(view, -normal).xyz, material.s_tex).xyz

    return {
        color = encode_rgbe8(color.xyz * lc.y + fres * pow(lc.z, 128.0))
    }
