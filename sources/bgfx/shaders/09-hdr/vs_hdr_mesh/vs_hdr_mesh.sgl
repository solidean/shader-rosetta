binding view:
    model_view: mat4
    model_view_proj: mat4

@vertex struct vertex_input:
    position: pos3
    normal: float3

struct varyings:
    @position position: hpos4
    pos: float3
    view: vec3
    normal: vec3

@vertex fun main(v: vertex_input){view} -> varyings:
    let pos = v.position
    let normal = v.normal * 2.0 - 1.0
    let position = view.model_view_proj * pos
    return {
        position = position
        pos = position.xyz
        view = vec3(..(view.model_view * pos).xyz)
        normal = view.model_view * vec3(..normal)
    }
