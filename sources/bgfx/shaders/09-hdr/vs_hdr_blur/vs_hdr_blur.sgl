// Copyright 2011-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    view_texel: float4
    model_view_proj: mat4

@vertex struct vertex_input:
    position: pos3
    texcoord0: float2

struct varyings:
    @position position: hpos4
    texcoord0: float2
    texcoord1: float4
    texcoord2: float4
    texcoord3: float4
    texcoord4: float4

@vertex fun main(v: vertex_input){view} -> varyings:
    let uv = v.texcoord0
    let texel = view.view_texel
    return {
        position = view.model_view_proj * v.position
        texcoord0 = uv
        texcoord1 = float4(uv.x, uv.y - texel.y * 1.0, uv.x, uv.y + texel.y * 1.0)
        texcoord2 = float4(uv.x, uv.y - texel.y * 2.0, uv.x, uv.y + texel.y * 2.0)
        texcoord3 = float4(uv.x, uv.y - texel.y * 3.0, uv.x, uv.y + texel.y * 3.0)
        texcoord4 = float4(uv.x, uv.y - texel.y * 4.0, uv.x, uv.y + texel.y * 4.0)
    }
