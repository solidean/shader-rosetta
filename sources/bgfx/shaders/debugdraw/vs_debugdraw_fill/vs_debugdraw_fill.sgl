// u_model holds BGFX_CONFIG_MAX_BONES = 2 matrices
binding view:
    view_proj: mat4
    model: mat4[2]

@vertex struct vertex_input:
    position: pos3
    indices: uint4

struct varyings:
    @position position: hpos4

@vertex fun main(v: vertex_input){view} -> varyings:
    let model = view.model[v.indices.x as int] * float4(..v.position, 1.0)
    return {
        position = hpos4(..(view.view_proj * model))
    }
