binding view:
    view_proj: mat4
    model: mat4

@vertex struct vertex_input:
    position: pos3

struct varyings:
    @position position: hpos4

@vertex fun main(v: vertex_input){view} -> varyings:
    let model = view.model * float4(..v.position, 1.0)
    return {
        position = hpos4(..(view.view_proj * model))
    }
