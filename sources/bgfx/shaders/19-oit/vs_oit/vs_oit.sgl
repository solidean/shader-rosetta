binding view:
    view: mat4
    view_proj: mat4
    model: mat4

@vertex struct vertex_input:
    position: float3

struct varyings:
    @position position: hpos4
    pos: float4

@vertex fun main(v: vertex_input){view} -> varyings:
    let wpos = (view.model * float4(..v.position, 1.0)).xyz
    let position = view.view_proj * pos3(..wpos)
    let mut pos = float4(..position)
    let temp = view.view * float4(..wpos, 1.0)
    pos.x = temp.z
    return {
        position = position
        pos = pos
    }
