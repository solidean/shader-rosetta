binding params:
    color: float4

struct varyings:
    @position position: hpos4
    pos: float4

@pixel struct target:
    accum: float4
    weight: float4

@pixel fun main(p: varyings){params} -> target:
    let color = params.color

    let depth = p.pos.z / p.pos.w

    let weight = color.w * clamp(0.03 / (1e-5 + pow(depth / 200.0, 5.0)), 0.01, 3000.0)
    return {
        accum = color * weight
        weight = float4(weight)
    }
