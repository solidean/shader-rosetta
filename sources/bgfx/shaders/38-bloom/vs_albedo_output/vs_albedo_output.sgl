binding view:
    view_proj: mat4
    model: mat4

@vertex struct vertex_input:
    position: pos3
    normal: float4
    tangent: float4
    texcoord0: float2

struct varyings:
    @position position: hpos4
    wpos: float3
    view: float3
    normal: float3
    tangent: float3
    bitangent: float3
    texcoord0: float2

@vertex fun main(v: vertex_input){view} -> varyings:
    let wpos = (view.model * v.position).xyz
    // the varyings the shader leaves unwritten keep their varying.def.sc defaults
    return {
        position = view.view_proj * pos3(..wpos)
        wpos = float3(0.0, 0.0, 0.0)
        view = float3(0.0, 0.0, 0.0)
        normal = float3(0.0, 0.0, 1.0)
        tangent = float3(1.0, 0.0, 0.0)
        bitangent = float3(0.0, 1.0, 0.0)
        texcoord0 = v.texcoord0
    }
