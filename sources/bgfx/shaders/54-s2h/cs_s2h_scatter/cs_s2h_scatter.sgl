// Port of ShaderToHuman-bgfx/examples/Features/Scatter_example.hlsl.

binding scatter:
    scatter_color: out image_2d[.rgba8_unorm]

binding params:
    s2h_scatter_size: float4

// ---- s2h.hlsl ----

// You can define this to provide your own font (different size, visual or better lookup performance by using a texture)
