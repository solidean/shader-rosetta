// todo: consider define or static cost int or float
// 8x8 font
fun s2h_font_size() -> float:
    return 8.0

// don't use directly
// can be used for scatter and gather
// @param ascii 32..127 are valid characters
// @param pxPos int2(0..s2h_fontSize()-1, 0..s2h_fontSize-1)
// @return true if there should be a pixel, false if not or outside the valid range
fun s2h_font_lookup(ascii: uint, px_pos: int2) -> bool:
    if (px_pos.x as uint) >= 8u or (px_pos.y as uint) >= 8u => return false

    if ascii <= 32u or ascii > 127u => return false

    // 0..16*6-1
    let chr = ascii - 32u
    // uint2(0..127, 0..47)
    let chr_pos = uint2(chr % 16u, chr / 16u)
    let pixel = uint2(chr_pos.x * 8u + (px_pos.x as uint), chr_pos.y * 8u + (px_pos.y as uint))
    let dword_id = pixel.x / 32u + (pixel.y * 4u)
    // 0..31
    let bit_id = pixel.x & 0x1fu

    // 0..ff
    let dword_value = g_mini_font[dword_id]

    return ((dword_value >> (31u - bit_id)) & 1u) != 0u

// don't use directly
fun s2h_print_character(ui: mut context_gather, ascii: uint):
    let px_local = int2(floor((ui.px_pos - ui.px_cursor) / ui.scale))

    if s2h_font_lookup(ascii, px_local):
        ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

const _A = 65u
const _B = 66u
const _C = 67u
const _D = 68u
const _E = 69u
const _F = 70u
const _H = 72u
const _I = 73u
const _L = 76u
const _N = 78u
const _O = 79u
const _P = 80u
const _R = 82u
const _S = 83u
const _T = 84u
const _U = 85u
const _X = 88u
const _Y = 89u
const _a = _A + 32u
const _b = _B + 32u
const _c = _C + 32u
const _d = _D + 32u
const _e = _E + 32u
const _f = _F + 32u
const _h = _H + 32u
const _i = _I + 32u
const _l = _L + 32u
const _n = _N + 32u
const _o = _O + 32u
const _r = _R + 32u
const _s = _S + 32u
const _t = _T + 32u
const _u = _U + 32u
const _x = _X + 32u
const _y = _Y + 32u
const _UNDERSCORE = 95u // _
const _MINUS = 45u // -
const _PERIOD = 46u // .
const _COLON = 58u // :
const _SPACE = 32u
const _EQUAL = 61u // =
const _0 = 48u
const _2 = 50u

// first call this
fun s2h_init(in_px_pos: float2) -> context_gather:
    return {
        // white, opaque
        text_color = float4(1.0, 1.0, 1.0, 1.0)
        px_left_x = 0.0
        px_cursor = float2(0.0, 0.0)
        scale = 1.0
        mouse_input = float4(-100.0, -100.0, 0.0, 0.0)

        px_pos = in_px_pos
        // see through
        dst_color = float4(0.0, 0.0, 0.0, 0.0)
        s2h_state = int4(0, 0, 0, 0)

        frame_fill_color = float4(0.9, 0.9, 0.9, 1.0)
        frame_border_color = float4(0.7, 0.7, 0.7, 1.0)
        button_color = float4(0.5, 0.5, 0.5, 1.0)
        line_width = 2.0
    }

// set text cursor position, next printLF() will reset to this x position
fun s2h_set_cursor(ui: mut context_gather, in_px_left_top: float2):
    ui.px_cursor = in_px_left_top
    ui.px_left_x = in_px_left_top.x

// @param scale 1:pixel perfect, 2:2x, 3:3x, ..
fun s2h_set_scale(ui: mut context_gather, scale: float):
    ui.scale = scale

// e.g. ui.s2h_printTxt('I', ' ', 'a', 'm');
// @param a ascii character or 0
fun s2h_print_txt(ui: mut context_gather, a: uint):
    s2h_print_character(mut ui, a)

// glsl has no default arguments to we implement multiple functions instead making porting easier
fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint):
    s2h_print_txt(mut ui, a)
    s2h_print_character(mut ui, b)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint):
    s2h_print_txt(mut ui, a, b)
    s2h_print_character(mut ui, c)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint):
    s2h_print_txt(mut ui, a, b, c)
    s2h_print_character(mut ui, d)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint, e: uint):
    s2h_print_txt(mut ui, a, b, c, d)
    s2h_print_character(mut ui, e)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint, e: uint, f: uint):
    s2h_print_txt(mut ui, a, b, c, d, e)
    s2h_print_character(mut ui, f)

// useful for table headers and to center text
fun s2h_print_space(ui: mut context_gather, number_of_chars: float):
    ui.px_cursor.x += s2h_font_size() * number_of_chars * ui.scale

// jump to next line (line feed)
fun s2h_print_lf(ui: mut context_gather):
    ui.px_cursor.x = ui.px_left_x
    ui.px_cursor.y += s2h_font_size() * ui.scale

// @param value e.g. 123, 0
fun s2h_print_int(ui: mut context_gather, value: int):
    let mut value = value
    // leading '-'
    if value < 0:
        s2h_print_character(mut ui, _MINUS)
        value = -value
    if value == 0:
        s2h_print_character(mut ui, _0)
        return
    // move to right depending on number length
    let mut tmp = value as uint
    while tmp != 0u:
        ui.px_cursor.x += s2h_font_size() * ui.scale
        tmp /= 10u
    // digits
    let backup = ui.px_cursor.x
    tmp = value as uint
    while tmp != 0u:
        // 0..9
        let digit = tmp % 10u
        tmp /= 10u
        // go backwards
        ui.px_cursor.x -= s2h_font_size() * ui.scale
        s2h_print_character(mut ui, _0 + digit)
        // counter +=s2h_fontSize() from printCharacter ()
        ui.px_cursor.x -= s2h_font_size() * ui.scale
    ui.px_cursor.x = backup

fun s2h_print_float(ui: mut context_gather, value: float):
    s2h_print_int(mut ui, value as int)
    let mut fractional = fract(abs(value))

    s2h_print_character(mut ui, _PERIOD)

    let digit_count = 3

    // todo: unit tests, this is likely wrong at lower precision

    // fractional digits
    for _ in 0 ..< digit_count:
        fractional *= 10.0
        // 0..9
        let digit = fractional as uint
        fractional = fract(fractional)
        s2h_print_character(mut ui, _0 + digit)

// @param aabb .x:minx, .y:miny, z:maxx, w:maxy
// The original takes ui inout and never writes it, so it is a plain parameter here.
fun s2h_compute_dist_to_box(ui: context_gather, p: float2, aabb: float4) -> float:
    let center = (aabb.xy + aabb.zw) * 0.5
    let half_size = (aabb.zw - aabb.xy) * 0.5
    let px_local = p - center // - float2(3.5f, 3.5f) / ui.scale;
    let dist2 = max(float2(0.0, 0.0), abs(px_local) - half_size)
    return max(dist2.x, dist2.y)

// useful for table headers
// similar to s2h_button but not interactive, call after using s2h_printTxt()
fun s2h_frame(ui: mut context_gather, width_in_characters: uint):
    let mut aabb = float4(..(ui.px_cursor - float2(width_in_characters as float, 0.0) * s2h_font_size() * ui.scale), ..ui.px_cursor)

    // shrink
    aabb += float4(4.0, 4.0, -4.0, 4.0) * ui.scale

    let dist = s2h_compute_dist_to_box(ui, ui.px_pos, aabb) / ui.scale

    let rim_mask = saturate(3.0 - dist)
    let outer_mask = saturate(4.0 - dist)

    let mut local_color = float4(0.0, 0.0, 0.0, 0.0)

    // no AA for now
    if outer_mask > 0.0 => local_color = ui.frame_border_color

    if rim_mask > 0.0 => local_color = ui.frame_fill_color

    ui.dst_color = mix(ui.dst_color, float4(..local_color.rgb, 1.0), local_color.a * (1.0 - ui.dst_color.a))

// see s2h_tableLookupInt()
fun s2h_table_int(ui: mut context_gather, column: uint, background_color: float4, size_in_characters: int2, go_right_not_down: bool):
    let px_char_size = s2h_font_size() * ui.scale
    let backup = ui.px_cursor
    let local_pos = ui.px_pos - ui.px_cursor
    let px_size = float2(size_in_characters) * px_char_size

    if local_pos.x >= 0.0 and local_pos.y >= 0.0 and local_pos.x < px_size.x and local_pos.y < px_size.y:
        ui.dst_color = mix(ui.dst_color, float4(..background_color.rgb, 1.0), background_color.a * (1.0 - ui.dst_color.a))

        let row = (local_pos.y / px_char_size) as int

        ui.px_cursor.y = backup.y + floor(local_pos.y / px_char_size) * px_char_size

        let lookup = s2h_table_lookup_int(column, row as uint)
        if lookup.valid:
            s2h_print_int(mut ui, lookup.value)
    if go_right_not_down:
        ui.px_cursor.x = backup.x + px_size.x
    else:
        s2h_print_lf(mut ui)
        ui.px_cursor.y = backup.y + px_size.y

// see s2h_tableLookupFloat()
// It lists the shader's own bindings that s2h_tableLookupFloat() reads.
fun s2h_table_float(ui: mut context_gather, column: uint, background_color: float4, size_in_characters: int2, go_right_not_down: bool){params}:
    let px_char_size = s2h_font_size() * ui.scale
    let backup = ui.px_cursor
    let local_pos = ui.px_pos - ui.px_cursor
    let px_size = float2(size_in_characters) * px_char_size

    if local_pos.x >= 0.0 and local_pos.y >= 0.0 and local_pos.x < px_size.x and local_pos.y < px_size.y:
        ui.dst_color = mix(ui.dst_color, float4(..background_color.rgb, 1.0), background_color.a * (1.0 - ui.dst_color.a))

        let row = (local_pos.y / px_char_size) as int

        ui.px_cursor.y = backup.y + floor(local_pos.y / px_char_size) * px_char_size

        let lookup = s2h_table_lookup_float(column, row as uint)
        if lookup.valid:
            s2h_print_float(mut ui, lookup.value)
    if go_right_not_down:
        ui.px_cursor.x = backup.x + px_size.x
    else:
        s2h_print_lf(mut ui)
        ui.px_cursor.y = backup.y + px_size.y

// required you to implement s2h_floatLookupFloat()
// It lists the shader's own bindings that s2h_floatLookupFloat() reads.
// @param rangeX float2(left, right) e.g. float2(0, 2.0f * 3.1415f)
// @param rangeY float2(top, bottom) e.g. float2(-1, 1)
fun s2h_function(ui: mut context_gather, function_id: uint, background_color: float4, size_in_characters: int2, range_x: float2, range_y: float2){params}:
    let scaled_font_size = s2h_font_size() * ui.scale

    let backup = ui.px_cursor
    let local_pos = ui.px_pos - ui.px_cursor
    let px_size = float2(size_in_characters) * scaled_font_size

    if local_pos.x >= 0.0 and local_pos.y >= 0.0 and local_pos.x < px_size.x and local_pos.y < px_size.y:
        // rangeX.x .. rangeX.y
        let x = mix(range_x.x, range_x.y, local_pos.x / px_size.x)

        ui.dst_color = mix(ui.dst_color, float4(..background_color.rgb, 1.0), background_color.a * (1.0 - ui.dst_color.a))

        let row = (local_pos.y / scaled_font_size) as int

        ui.px_cursor.y = backup.y + floor(local_pos.y / scaled_font_size) * scaled_font_size

        // rangeY.x .. rangeY.y
        let y = s2h_float_lookup_float(function_id, x)
        // 0 .. pxSize.y
        let px_y = (1.0 - (y - range_y.x) / (range_y.y - range_y.x)) * px_size.y

        if px_y < local_pos.y => ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    s2h_print_lf(mut ui)
    ui.px_cursor.y = backup.y + px_size.y

// The original's out parameter is the value of the result, which keeps the caller's 0 where it is not valid.
fun s2h_table_lookup_int(column: uint, row: uint) -> s2h_lookup_int:
    if 1u == column:
        if row > 10u => return {valid = false, value = 0}
        return {valid = true, value = 2 + ((row * row) as int)}
    else:
        if row > 12u => return {valid = false, value = 0}
        return {valid = true, value = row as int}

fun s2h_table_lookup_float(column: uint, row: uint){params} -> s2h_lookup_float:
    if column == 2u and row <= 10u:
        return {valid = true, value = sin(params.s2h_time.x + (row as float) * 0.5)}
    if column == 3u and row <= 10u:
        return {valid = true, value = cos(params.s2h_time.x + (row as float) * 0.5)}
    return {valid = false, value = 0.0}

fun s2h_float_lookup_float(function_id: uint, x: float){params} -> float:
    return sin(x) + cos(params.s2h_time.x * 3.0 + x * 15.0) * 0.1

@pixel fun main(p: varyings){params} -> target:
    let mut ui = s2h_init(s2h_get_pixel_coord(p.position.xy))
    s2h_set_cursor(mut ui, float2(10.0, 10.0))

    ui.text_color.rgb = float3(1.0, 1.0, 1.0)
    s2h_set_scale(mut ui, 3.0)
    s2h_print_txt(mut ui, _T, _a, _b, _l, _e)
    s2h_print_txt(mut ui, _T, _e, _s, _t)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    ui.text_color.rgb = float3(0.0, 0.0, 0.0)
    s2h_set_scale(mut ui, 2.0)
    s2h_print_txt(mut ui, _P, _i, _x, _e, _l, _EQUAL)
    s2h_print_txt(mut ui, _T, _h, _r, _e, _a, _d)
    s2h_set_scale(mut ui, 3.0)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)

    s2h_set_scale(mut ui, 2.0)
    s2h_print_txt(mut ui, _s, _2, _h, _UNDERSCORE)
    s2h_print_txt(mut ui, _t, _a, _b, _l, _e)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)

    s2h_print_space(mut ui, 0.5)
    s2h_print_txt(mut ui, _I, _d)
    s2h_print_space(mut ui, 0.5)
    s2h_frame(mut ui, 3u)
    s2h_print_space(mut ui, 1.0)
    s2h_print_txt(mut ui, _C, _n, _t)
    s2h_print_space(mut ui, 1.0)
    s2h_frame(mut ui, 5u)
    s2h_print_space(mut ui, 3.0)
    s2h_print_txt(mut ui, _x)
    s2h_print_space(mut ui, 3.0)
    s2h_frame(mut ui, 7u)
    s2h_print_space(mut ui, 3.0)
    s2h_print_txt(mut ui, _y)
    s2h_print_space(mut ui, 3.0)
    s2h_frame(mut ui, 7u)
    s2h_print_lf(mut ui)

    s2h_table_int(mut ui, 0u, float4(1.0, 1.0, 1.0, 0.35), int2(3, 15), true)
    s2h_table_int(mut ui, 1u, float4(0.4, 0.4, 0.4, 0.75), int2(5, 15), true)
    s2h_table_float(mut ui, 2u, float4(1.0, 0.0, 0.0, 0.35), int2(7, 15), true)
    s2h_table_float(mut ui, 3u, float4(0.0, 1.0, 0.0, 0.25), int2(7, 15), false)

    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _s, _2, _h, _UNDERSCORE, _f, _u)
    s2h_print_txt(mut ui, _n, _c, _t, _i, _o, _n)
    s2h_print_lf(mut ui)

    s2h_set_scale(mut ui, 2.0)
    ui.text_color.rgb = float3(1.0, 1.0, 1.0)
    let range_x = float2(0.0, 3.14159265 * 2.0)
    let range_y = float2(-1.3, 1.3)
    s2h_function(mut ui, 0u, float4(0.0, 0.0, 0.0, 0.45), int2(22, 8), range_x, range_y)

    ui.text_color.rgb = float3(0.0, 0.0, 0.0)
    s2h_print_txt(mut ui, _x, _COLON, _SPACE)
    s2h_print_float(mut ui, range_x.x)
    s2h_print_txt(mut ui, _SPACE, _PERIOD, _PERIOD, _SPACE)
    s2h_print_float(mut ui, range_x.y)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _y, _COLON, _SPACE)
    s2h_print_float(mut ui, range_y.x)
    s2h_print_txt(mut ui, _SPACE, _PERIOD, _PERIOD, _SPACE)
    s2h_print_float(mut ui, range_y.y)

    let background = float4(0.4, 0.7, 0.4, 1.0)
    return {
        color = mix(background, float4(..ui.dst_color.rgb, 1.0), ui.dst_color.a)
    }
