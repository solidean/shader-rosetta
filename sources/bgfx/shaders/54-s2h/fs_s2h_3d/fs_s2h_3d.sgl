// todo: consider define or static cost int or float
// 8x8 font
fun s2h_font_size() -> float:
    return 8.0

// don't use directly
// can be used for scatter and gather
// @param ascii 32..127 are valid characters
// @param pxPos int2(0..s2h_fontSize()-1, 0..s2h_fontSize-1)
// @return true if there should be a pixel, false if not or outside the valid range
fun s2h_font_lookup(ascii: uint, px_pos: int2) -> bool:
    if (px_pos.x as uint) >= 8u or (px_pos.y as uint) >= 8u => return false

    if ascii <= 32u or ascii > 127u => return false

    // 0..16*6-1
    let chr = ascii - 32u
    // uint2(0..127, 0..47)
    let chr_pos = uint2(chr % 16u, chr / 16u)
    let pixel = uint2(chr_pos.x * 8u + (px_pos.x as uint), chr_pos.y * 8u + (px_pos.y as uint))
    let dword_id = pixel.x / 32u + (pixel.y * 4u)
    // 0..31
    let bit_id = pixel.x & 0x1fu

    // 0..ff
    let dword_value = g_mini_font[dword_id]

    return ((dword_value >> (31u - bit_id)) & 1u) != 0u

// don't use directly
fun s2h_print_character(ui: mut context_gather, ascii: uint):
    let px_local = int2(floor((ui.px_pos - ui.px_cursor) / ui.scale))

    if s2h_font_lookup(ascii, px_local):
        ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

const _O = 79u
const _P = 80u
const _S = 83u
const _o = _O + 32u
const _s = _S + 32u
const _MINUS = 45u // -
const _PERIOD = 46u // .
const _COLON = 58u // :
const _COMMA = 44u // ,
const _0 = 48u

// first call this
fun s2h_init(in_px_pos: float2) -> context_gather:
    return {
        // white, opaque
        text_color = float4(1.0, 1.0, 1.0, 1.0)
        px_left_x = 0.0
        px_cursor = float2(0.0, 0.0)
        scale = 1.0
        mouse_input = float4(-100.0, -100.0, 0.0, 0.0)

        px_pos = in_px_pos
        // see through
        dst_color = float4(0.0, 0.0, 0.0, 0.0)
        s2h_state = int4(0, 0, 0, 0)

        frame_fill_color = float4(0.9, 0.9, 0.9, 1.0)
        frame_border_color = float4(0.7, 0.7, 0.7, 1.0)
        button_color = float4(0.5, 0.5, 0.5, 1.0)
        line_width = 2.0
    }

// set text cursor position, next printLF() will reset to this x position
fun s2h_set_cursor(ui: mut context_gather, in_px_left_top: float2):
    ui.px_cursor = in_px_left_top
    ui.px_left_x = in_px_left_top.x

// @param scale 1:pixel perfect, 2:2x, 3:3x, ..
fun s2h_set_scale(ui: mut context_gather, scale: float):
    ui.scale = scale

// e.g. ui.s2h_printTxt('I', ' ', 'a', 'm');
// @param a ascii character or 0
fun s2h_print_txt(ui: mut context_gather, a: uint):
    s2h_print_character(mut ui, a)

// glsl has no default arguments to we implement multiple functions instead making porting easier
fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint):
    s2h_print_txt(mut ui, a)
    s2h_print_character(mut ui, b)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint):
    s2h_print_txt(mut ui, a, b)
    s2h_print_character(mut ui, c)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint):
    s2h_print_txt(mut ui, a, b, c)
    s2h_print_character(mut ui, d)

// @param value e.g. 123, 0
fun s2h_print_int(ui: mut context_gather, value: int):
    let mut value = value
    // leading '-'
    if value < 0:
        s2h_print_character(mut ui, _MINUS)
        value = -value
    if value == 0:
        s2h_print_character(mut ui, _0)
        return
    // move to right depending on number length
    let mut tmp = value as uint
    while tmp != 0u:
        ui.px_cursor.x += s2h_font_size() * ui.scale
        tmp /= 10u
    // digits
    let backup = ui.px_cursor.x
    tmp = value as uint
    while tmp != 0u:
        // 0..9
        let digit = tmp % 10u
        tmp /= 10u
        // go backwards
        ui.px_cursor.x -= s2h_font_size() * ui.scale
        s2h_print_character(mut ui, _0 + digit)
        // counter +=s2h_fontSize() from printCharacter ()
        ui.px_cursor.x -= s2h_font_size() * ui.scale
    ui.px_cursor.x = backup

fun s2h_print_float(ui: mut context_gather, value: float):
    s2h_print_int(mut ui, value as int)
    let mut fractional = fract(abs(value))

    s2h_print_character(mut ui, _PERIOD)

    let digit_count = 3

    // todo: unit tests, this is likely wrong at lower precision

    // fractional digits
    for _ in 0 ..< digit_count:
        fractional *= 10.0
        // 0..9
        let digit = fractional as uint
        fractional = fract(fractional)
        s2h_print_character(mut ui, _0 + digit)

// slow but accurate
fun s2h_accurate_linear_to_srgb(linear_col: float3) -> float3:
    let srgb_lo = linear_col * 12.92
    let srgb_hi = (pow(abs(linear_col), float3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) * 1.055) - 0.055
    return float3(
        if linear_col.r <= 0.0031308 => srgb_lo.r else srgb_hi.r,
        if linear_col.g <= 0.0031308 => srgb_lo.g else srgb_hi.g,
        if linear_col.b <= 0.0031308 => srgb_lo.b else srgb_hi.b
    )

// ---- s2h_3d.hlsl ----

struct context_3d:
    // ray origin
    ro: float3
    // ray direction, normalized?
    rd: float3
    // surfacePos = ro + rd * depth
    depth: float
    dst_color: float4

// s2h_boxIntersection's result and its out parameter
struct s2h_box_hit:
    t: float2
    normal: float3

// @param ro ray origin
// @param ro ray direction
fun s2h_init(ro: float3, rd: float3) -> context_3d:
    return {
        ro = ro
        rd = rd
        depth = s2h_flt_max
        dst_color = float4(0.0, 0.0, 0.0, 0.0)
    }

// Inigo Quilez box ray intersection https://iquilezles.org/articles/intersectors
// axis aligned box centered at the origin, with size boxSize
fun s2h_box_intersection(ro: float3, rd: float3, box_size: float3) -> s2h_box_hit:
    let m = 1.0 / rd // can precompute if traversing a set of aligned boxes
    let n = m * ro   // can precompute if traversing a set of aligned boxes
    let k = abs(m) * box_size
    let t1 = -n - k
    let t2 = -n + k
    let t_n = max(max(t1.x, t1.y), t1.z)
    let t_f = min(min(t2.x, t2.y), t2.z)
    if t_n > t_f or t_f < 0.0 => return {t = float2(-1.0, -1.0), normal = float3(0.0, 0.0, 0.0)} // no intersection
    let mut out_normal = if t_n > 0.0 => step(float3(t_n, t_n, t_n), t1) // ro outside the box
        else step(t2, float3(t_f, t_f, t_f)) // ro inside the box
    out_normal *= -sign(rd)
    return {t = float2(t_n, t_f), normal = out_normal}

// Inigo Quilez box cylinder intersection https://iquilezles.org/articles/intersectors
// cylinder defined by extremes a and b, and radious ra
fun s2h_cyl_intersect(ro: float3, rd: float3, a: float3, b: float3, ra: float) -> float4:
    let ba = b - a
    let oc = ro - a
    let baba = dot(ba, ba)
    let bard = dot(ba, rd)
    let baoc = dot(ba, oc)
    let k2 = baba - bard * bard
    let k1 = baba * dot(oc, rd) - baoc * bard
    let k0 = baba * dot(oc, oc) - baoc * baoc - ra * ra * baba
    let mut h = k1 * k1 - k2 * k0
    if h < 0.0 => return float4(-1.0, -1.0, -1.0, -1.0) // no intersection
    h = sqrt(h)
    let mut t = (-k1 - h) / k2
    // body
    let y = baoc + t * bard
    if y > 0.0 and y < baba => return float4(t, ..((oc + t * rd - ba * y / baba) / ra))
    // caps
    t = ((if y < 0.0 => 0.0 else baba) - baoc) / bard
    if abs(k1 + k2 * t) < h:
        return float4(t, ..(ba * sign(y) / sqrt(baba)))
    return float4(-1.0, -1.0, -1.0, -1.0) // no intersection

// normal at point p of cylinder (a,b,ra), see above
fun s2h_cyl_normal(p: float3, a: float3, b: float3, ra: float) -> float3:
    let pa = p - a
    let ba = b - a
    let baba = dot(ba, ba)
    let paba = dot(pa, ba)
    let h = dot(pa, ba) / baba
    return (pa - ba * h) / ra

fun s2h_dot2(p: float3) -> float:
    return dot(p, p)

// cone defined by extremes pa and pb, and radious ra and rb
// Only one square root and one division is emplyed in the worst case. s2h_dot2(v) is dot(v,v)
// @param float4(t, normal)
fun s2h_cone_intersect(ro: float3, rd: float3, pa: float3, pb: float3, ra: float, rb: float) -> float4:
    let ba = pb - pa
    let oa = ro - pa
    let ob = ro - pb
    let m0 = dot(ba, ba)
    let m1 = dot(oa, ba)
    let m2 = dot(rd, ba)
    let m3 = dot(rd, oa)
    let m5 = dot(oa, oa)
    let m9 = dot(ob, ba)

    // caps
    if m1 < 0.0:
        if s2h_dot2(oa * m2 - rd * m1) < (ra * ra * m2 * m2) => return float4(-m1 / m2, ..(-ba * inverse_sqrt(m0))) // delayed division
    else if m9 > 0.0:
        let t = -m9 / m2 // NOT delayed division
        if s2h_dot2(ob + rd * t) < (rb * rb) => return float4(t, ..(ba * inverse_sqrt(m0)))

    // body
    let rr = ra - rb
    let hy = m0 + rr * rr
    let k2 = m0 * m0 - m2 * m2 * hy
    let k1 = m0 * m0 * m3 - m1 * m2 * hy + m0 * ra * (rr * m2 * 1.0)
    let k0 = m0 * m0 * m5 - m1 * m1 * hy + m0 * ra * (rr * m1 * 2.0 - m0 * ra)
    let h = k1 * k1 - k2 * k0
    if h < 0.0 => return float4(-1.0, -1.0, -1.0, -1.0) // no intersection
    let t = (-k1 - sqrt(h)) / k2
    let y = m1 + t * m2
    if y < 0.0 or y > m0 => return float4(-1.0, -1.0, -1.0, -1.0) // no intersection
    return float4(t, ..normalize(m0 * (m0 * (oa + t * rd) + rr * ba * ra) - ba * hy * y))

// @param thickness e.g. 0.09f
fun s2h_draw_line_ws(context: mut context_3d, from: float3, to: float3, color: float4, thickness: float):
    let hit = s2h_cyl_intersect(context.ro, context.rd, from, to, thickness).xy

    if hit.x > 0.0 and hit.x < context.depth:
        context.depth = hit.x
        let p = context.ro + context.depth * context.rd
        let normal = s2h_cyl_normal(p, from, to, thickness)
        // todo: refine shading
        let mut color = color
        color.rgb = mix(color.rgb, normal * 0.5 + 0.5, 0.3)
        context.dst_color = color

fun s2h_draw_arrow_ws(context: mut context_3d, from: float3, to: float3, color: float4, thickness: float):
    let hit = s2h_cone_intersect(context.ro, context.rd, from, to, thickness, 0.0)

    if hit.x > 0.0 and hit.x < context.depth:
        context.depth = hit.x
        let normal = hit.yzw
        // todo: refine shading
        let mut color = color
        color.rgb = mix(color.rgb, normal * 0.5 + 0.5, 0.3)
        context.dst_color = color

// @param worldFromObject aka objectToWorld
// @param r in world space units
fun s2h_draw_basis(context: mut context_3d, world_from_object: mat4, r: float):
    let o_hom = world_from_object * float4(0.0, 0.0, 0.0, 1.0)
    let x_hom = world_from_object * float4(r, 0.0, 0.0, 1.0)
    let y_hom = world_from_object * float4(0.0, r, 0.0, 1.0)
    let z_hom = world_from_object * float4(0.0, 0.0, r, 1.0)

    let o = o_hom.xyz / o_hom.w
    let x = x_hom.xyz / x_hom.w
    let y = y_hom.xyz / y_hom.w
    let z = z_hom.xyz / z_hom.w

    s2h_draw_arrow_ws(mut context, o, x, float4(1.0, 0.0, 0.0, 1.0), 0.09)
    s2h_draw_arrow_ws(mut context, o, y, float4(0.0, 1.0, 0.0, 1.0), 0.09)
    s2h_draw_arrow_ws(mut context, o, z, float4(0.0, 0.0, 1.0, 1.0), 0.09)

// 8x8 checker board with X (red) and Z (blue) around offset pointing up (Y+)
fun s2h_draw_checker_board(context: mut context_3d, offset: float3):
    let pos = float3(0.0, -0.2, 0.0) + offset
    let size = float3(4.4, 0.2, 4.4)
    let box = s2h_box_intersection(context.ro - pos, context.rd, size)
    let hit = box.t
    let normal = box.normal

    if hit.y > 0.0 and hit.x < context.depth:
        context.depth = hit.x

        let hit_pos = context.ro + hit.x * context.rd
        let uv = hit_pos.zx

        let mut value = 1.0

        if abs(uv.x) < 4.0 and abs(uv.y) < 4.0:
            value = if fract(floor(uv.x) * 0.5 + floor(uv.y) * 0.5) > 0.25 => 0.4 else 0.6

        context.dst_color = float4(value, value, value, 1.0)

        if abs(uv.x) < (4.0 - uv.y) * 0.1 and uv.y > 0.0 => context.dst_color.rgb = float3(1.0, 0.0, 0.0)
        if abs(uv.y) < (4.0 - uv.x) * 0.1 and uv.x > 0.0 => context.dst_color.rgb = float3(0.0, 0.0, 1.0)
        if dot(uv, uv) < 0.25 => context.dst_color.rgb = float3(0.0, 1.0, 0.0)

        context.dst_color = mix(context.dst_color, float4(..(normal * 0.5 + 0.5), 1.0), 0.3)

// scene() is the shader's own
fun scene_with_shadows(context: mut context_3d):
    scene(mut context)

    let lit_scene = context.dst_color

    // shadow ray, experiment, todo: expose light direction
    if context.depth < s2h_flt_max:
        // 0..1
        let mut visible: float
        let bias = 0.001
        let mut shadow_context = s2h_init(context.ro + context.depth * context.rd, normalize(float3(1.0, 3.0, 2.0)))
        shadow_context.ro += bias * shadow_context.rd

        scene(mut shadow_context)
        visible = if shadow_context.depth == s2h_flt_max => 1.0 else 0.0

        // shadows are grey, todo: expose ambient color
        let shadow_factor = 0.5 - visible * 0.5
        context.dst_color.rgb = mix(lit_scene.rgb, float3(0.0, 0.0, 0.0), shadow_factor)

fun scene(context: mut context_3d):
    let offset = float3(0.0, -1.0, 0.0)
    s2h_draw_checker_board(mut context, offset)
    s2h_draw_line_ws(mut context, float3(-1.0, 2.0, 1.0) + offset, float3(1.0, 2.0, 1.0) + offset, float4(1.0, 1.0, 0.0, 1.0), 0.09)
    s2h_draw_line_ws(mut context, float3(-1.0, 2.0, -1.0) + offset, float3(1.0, 2.0, -1.0) + offset, float4(1.0, 1.0, 0.0, 1.0), 0.09)
    s2h_draw_line_ws(mut context, float3(-1.0, 2.0, -1.0) + offset, float3(-1.0, 2.0, 1.0) + offset, float4(1.0, 1.0, 0.0, 1.0), 0.09)
    s2h_draw_line_ws(mut context, float3(1.0, 2.0, -1.0) + offset, float3(1.0, 2.0, 1.0) + offset, float4(1.0, 1.0, 0.0, 1.0), 0.09)

fun safe_normalize(value: float3) -> float3:
    return value / max(length(value), 0.0001)

fun look_at(eye: float3, target: float3, up: float3) -> mat4:
    let zaxis = safe_normalize(target - eye)
    let xaxis = safe_normalize(cross(up, zaxis))
    let yaxis = cross(zaxis, xaxis)
    // The original takes its non-GLSL arm, the transpose of an HLSL mat4 of these rows: the mat4 of these columns.
    return mat4(float4(..xaxis, 0.0), float4(..yaxis, 0.0), float4(..zaxis, 0.0), float4(..eye, 1.0))

@pixel fun main(p: varyings){view, params} -> target:
    let resolution = view.view_rect.zw
    let pixel = s2h_get_pixel_coord(p.position.xy)
    let uv = pixel / resolution
    let mut screen = uv * 2.0 - 1.0
    screen.x *= resolution.x / resolution.y
    screen.y = -screen.y

    let orbit = params.s2h_time.x * 0.35
    let camera_position = float3(sin(orbit) * 5.0, 2.5, cos(orbit) * 5.0)
    let camera_forward = safe_normalize(float3(0.0, 0.4, 0.0) - camera_position)
    let camera_right = safe_normalize(cross(float3(0.0, 1.0, 0.0), camera_forward))
    let camera_up = cross(camera_forward, camera_right)
    let ray_direction = safe_normalize(camera_forward + screen.x * camera_right * 0.8 + screen.y * camera_up * 0.8)

    let mut context = s2h_init(camera_position, ray_direction)
    context.dst_color = float4(..(safe_normalize(ray_direction * 0.5 + 0.5) * 0.25), 1.0)
    scene_with_shadows(mut context)
    scene(mut context)

    let s = sin(params.s2h_time.x) * 3.0
    let c = cos(params.s2h_time.x) * 3.0
    s2h_draw_basis(mut context, look_at(float3(s, 1.0, c), float3(0.0, 1.0, 0.0), float3(0.0, 1.0, 0.0)), 1.0)

    let mut ui = s2h_init(pixel)
    s2h_set_cursor(mut ui, float2(10.0, 10.0))
    s2h_set_scale(mut ui, 2.0)
    s2h_print_txt(mut ui, _P, _o, _s, _COLON)
    s2h_print_float(mut ui, camera_position.x)
    s2h_print_txt(mut ui, _COMMA)
    s2h_print_float(mut ui, camera_position.y)
    s2h_print_txt(mut ui, _COMMA)
    s2h_print_float(mut ui, camera_position.z)

    let mut color = mix(float3(0.0, 0.0, 0.0), context.dst_color.rgb, context.dst_color.a)
    color = color * (1.0 - ui.dst_color.a) + ui.dst_color.rgb
    return {
        color = float4(..s2h_accurate_linear_to_srgb(color), 1.0)
    }
