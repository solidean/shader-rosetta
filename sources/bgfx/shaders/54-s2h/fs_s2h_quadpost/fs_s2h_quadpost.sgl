// Translated to SGL from bgfx examples/54-s2h/fs_s2h_quadpost.sc.
// The original carries no copyright line; bgfx: Copyright 2010-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

// The original includes s2h_bgfx.sh and uses nothing of it.

binding view:
    view_rect: float4

binding params:
    s2h_mouse: float4

binding material:
    quad_post_color: texture_2d[float4]
    sampler s_quad_post_color:
        filter = .linear

struct varyings:
    @position position: hpos4
    color0: float4
    texcoord0: float2

@pixel struct target:
    color: float4

@pixel fun main(p: varyings){view, params, material} -> target:
    let uv = p.texcoord0
    let mut color = material.quad_post_color.sample(uv, material.s_quad_post_color).rgb
    let mouse_uv = params.s2h_mouse.xy / view.view_rect.zw
    let delta = uv - mouse_uv
    let highlight = 1.0 - smoothstep(0.02, 0.025, length(delta))
    color = mix(color, float3(1.0, 1.0, 0.0), highlight)
    return {
        color = float4(..color, 1.0)
    }
