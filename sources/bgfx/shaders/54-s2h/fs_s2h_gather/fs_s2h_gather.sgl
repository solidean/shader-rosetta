// todo: consider define or static cost int or float
// 8x8 font
fun s2h_font_size() -> float:
    return 8.0

// don't use directly
// can be used for scatter and gather
// @param ascii 32..127 are valid characters
// @param pxPos int2(0..s2h_fontSize()-1, 0..s2h_fontSize-1)
// @return true if there should be a pixel, false if not or outside the valid range
fun s2h_font_lookup(ascii: uint, px_pos: int2) -> bool:
    if (px_pos.x as uint) >= 8u or (px_pos.y as uint) >= 8u => return false

    if ascii <= 32u or ascii > 127u => return false

    // 0..16*6-1
    let chr = ascii - 32u
    // uint2(0..127, 0..47)
    let chr_pos = uint2(chr % 16u, chr / 16u)
    let pixel = uint2(chr_pos.x * 8u + (px_pos.x as uint), chr_pos.y * 8u + (px_pos.y as uint))
    let dword_id = pixel.x / 32u + (pixel.y * 4u)
    // 0..31
    let bit_id = pixel.x & 0x1fu

    // 0..ff
    let dword_value = g_mini_font[dword_id]

    return ((dword_value >> (31u - bit_id)) & 1u) != 0u

// don't use directly
fun s2h_print_character(ui: mut context_gather, ascii: uint):
    let px_local = int2(floor((ui.px_pos - ui.px_cursor) / ui.scale))

    if s2h_font_lookup(ascii, px_local):
        ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

const _A = 65u
const _B = 66u
const _C = 67u
const _D = 68u
const _E = 69u
const _F = 70u
const _G = 71u
const _H = 72u
const _I = 73u
const _K = 75u
const _L = 76u
const _M = 77u
const _N = 78u
const _O = 79u
const _P = 80u
const _R = 82u
const _S = 83u
const _T = 84u
const _U = 85u
const _X = 88u
const _Y = 89u
const _Z = 90u
const _a = _A + 32u
const _b = _B + 32u
const _c = _C + 32u
const _d = _D + 32u
const _e = _E + 32u
const _g = _G + 32u
const _h = _H + 32u
const _i = _I + 32u
const _k = _K + 32u
const _l = _L + 32u
const _n = _N + 32u
const _o = _O + 32u
const _p = _P + 32u
const _r = _R + 32u
const _s = _S + 32u
const _t = _T + 32u
const _u = _U + 32u
const _x = _X + 32u
const _UNDERSCORE = 95u // _
const _MINUS = 45u // -
const _PERIOD = 46u // .
const _COLON = 58u // :
const _COMMA = 44u // ,
const _SPACE = 32u
const _LESS = 60u // <
const _EQUAL = 61u // =
const _0 = 48u
const _2 = 50u

// first call this
fun s2h_init(in_px_pos: float2) -> context_gather:
    return {
        // white, opaque
        text_color = float4(1.0, 1.0, 1.0, 1.0)
        px_left_x = 0.0
        px_cursor = float2(0.0, 0.0)
        scale = 1.0
        mouse_input = float4(-100.0, -100.0, 0.0, 0.0)

        px_pos = in_px_pos
        // see through
        dst_color = float4(0.0, 0.0, 0.0, 0.0)
        s2h_state = int4(0, 0, 0, 0)

        frame_fill_color = float4(0.9, 0.9, 0.9, 1.0)
        frame_border_color = float4(0.7, 0.7, 0.7, 1.0)
        button_color = float4(0.5, 0.5, 0.5, 1.0)
        line_width = 2.0
    }

// set text cursor position, next printLF() will reset to this x position
fun s2h_set_cursor(ui: mut context_gather, in_px_left_top: float2):
    ui.px_cursor = in_px_left_top
    ui.px_left_x = in_px_left_top.x

// @param scale 1:pixel perfect, 2:2x, 3:3x, ..
fun s2h_set_scale(ui: mut context_gather, scale: float):
    ui.scale = scale

// e.g. ui.s2h_printTxt('I', ' ', 'a', 'm');
// @param a ascii character or 0
fun s2h_print_txt(ui: mut context_gather, a: uint):
    s2h_print_character(mut ui, a)

// glsl has no default arguments to we implement multiple functions instead making porting easier
fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint):
    s2h_print_txt(mut ui, a)
    s2h_print_character(mut ui, b)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint):
    s2h_print_txt(mut ui, a, b)
    s2h_print_character(mut ui, c)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint):
    s2h_print_txt(mut ui, a, b, c)
    s2h_print_character(mut ui, d)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint, e: uint):
    s2h_print_txt(mut ui, a, b, c, d)
    s2h_print_character(mut ui, e)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint, e: uint, f: uint):
    s2h_print_txt(mut ui, a, b, c, d, e)
    s2h_print_character(mut ui, f)

// jump to next line (line feed)
fun s2h_print_lf(ui: mut context_gather):
    ui.px_cursor.x = ui.px_left_x
    ui.px_cursor.y += s2h_font_size() * ui.scale

// @param value e.g. 123, 0
fun s2h_print_int(ui: mut context_gather, value: int):
    let mut value = value
    // leading '-'
    if value < 0:
        s2h_print_character(mut ui, _MINUS)
        value = -value
    if value == 0:
        s2h_print_character(mut ui, _0)
        return
    // move to right depending on number length
    let mut tmp = value as uint
    while tmp != 0u:
        ui.px_cursor.x += s2h_font_size() * ui.scale
        tmp /= 10u
    // digits
    let backup = ui.px_cursor.x
    tmp = value as uint
    while tmp != 0u:
        // 0..9
        let digit = tmp % 10u
        tmp /= 10u
        // go backwards
        ui.px_cursor.x -= s2h_font_size() * ui.scale
        s2h_print_character(mut ui, _0 + digit)
        // counter +=s2h_fontSize() from printCharacter ()
        ui.px_cursor.x -= s2h_font_size() * ui.scale
    ui.px_cursor.x = backup

// print hexadecimal e.g. "0000aa34"
// @param value 32bit e.g. 0x123, 0xff00
fun s2h_print_hex(ui: mut context_gather, value: uint):
    // 8 nibbles, i from 7 down to 0
    for k in 0 ..< 8:
        let i = 7 - k
        // 0..15
        let nibble = (value >> ((i as uint) * 4u)) & 0xfu
        let start = if nibble < 10u => _0 else _A - 10u
        s2h_print_character(mut ui, start + nibble)

fun s2h_print_float(ui: mut context_gather, value: float):
    s2h_print_int(mut ui, value as int)
    let mut fractional = fract(abs(value))

    s2h_print_character(mut ui, _PERIOD)

    let digit_count = 3

    // todo: unit tests, this is likely wrong at lower precision

    // fractional digits
    for _ in 0 ..< digit_count:
        fractional *= 10.0
        // 0..9
        let digit = fractional as uint
        fractional = fract(fractional)
        s2h_print_character(mut ui, _0 + digit)

// block in a s2h_fontSize() x s2h_fontSize() character
fun s2h_print_box(ui: mut context_gather, color: float4):
    let px_local = (ui.px_pos - ui.px_cursor) / ui.scale - float2(4.0, 4.0)

    let mask = saturate(4.0 - max(abs(px_local.x), abs(px_local.y)))

    //	dstColor = lerp(dstColor, float4(color.rgb, 1), color.a * mask);
    if mask > 0.0 => ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

// draw anti aliased filled disc
fun s2h_draw_disc(ui: mut context_gather, px_center: float2, px_radius: float, color: float4):
    let px_local = ui.px_pos - px_center

    let len = length(px_local)
    let mask = saturate(px_radius - len)

    ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a * mask)

// circle in a s2h_fontSize() x s2h_fontSize() character
fun s2h_print_disc(ui: mut context_gather, color: float4):
    let px_local = (ui.px_pos - ui.px_cursor) / ui.scale - float2(4.0, 4.0)

    let mask = saturate(4.0 - length(px_local))

    //	dstColor = lerp(stColor, float4(color.rgb, 1), color.a * mask);
    // no AA for now
    if mask > 0.0 => ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

// @param aabb .x:minx, .y:miny, z:maxx, w:maxy
// The original takes ui inout and never writes it, so it is a plain parameter here.
fun s2h_compute_dist_to_box(ui: context_gather, p: float2, aabb: float4) -> float:
    let center = (aabb.xy + aabb.zw) * 0.5
    let half_size = (aabb.zw - aabb.xy) * 0.5
    let px_local = p - center // - float2(3.5f, 3.5f) / ui.scale;
    let dist2 = max(float2(0.0, 0.0), abs(px_local) - half_size)
    return max(dist2.x, dist2.y)

// for state-full UI:

// call after using s2h_printTxt()
// e.g. if(s2h_button(ui, 5, float4(1,0,1,1))) do();
fun s2h_button(ui: mut context_gather, width_in_characters: uint) -> bool:
    let color = ui.button_color
    let border = 0.0

    let mut aabb = float4(..(ui.px_cursor - float2(width_in_characters as float, 0.0) * s2h_font_size() * ui.scale), ..ui.px_cursor)

    // shrink
    aabb += float4(4.0, 4.0, -4.0, 4.0) * ui.scale

    let dist = s2h_compute_dist_to_box(ui, ui.px_pos, aabb) / ui.scale
    let mouse_over = s2h_compute_dist_to_box(ui, ui.mouse_input.xy, aabb) / ui.scale < 5.0 + border

    let rim_mask = saturate(5.0 - dist + border)
    let outer_mask = saturate(4.0 - dist + border)

    let mut local_color = float4(0.0, 0.0, 0.0, 0.0)

    if mouse_over and rim_mask > 0.0 => local_color = float4(1.0, 1.0, 1.0, 1.0)

    // no AA for now
    if outer_mask > 0.0 => local_color = color

    ui.dst_color = mix(ui.dst_color, float4(..local_color.rgb, 1.0), local_color.a * (1.0 - ui.dst_color.a))

    let delta = round(ui.mouse_input.xy + 0.5 - ui.px_pos)

    return mouse_over and delta.x == 0.0 and delta.y == 0.0

// circle in a s2h_fontSize() x s2h_fontSize() character with mouse over
// e.g. if(s2h_radioButton(ui, float4(1,0,0,1), UIState[0].SplatMode == 0) && leftMouse) UIState[0].SplatMode = 0;
// @param checked fill inside using textColor
// @return mouseOver (can be used as button or radio button)
fun s2h_radio_button(ui: mut context_gather, checked: bool) -> bool:
    let color = ui.button_color

    let px_local = (ui.px_pos - ui.px_cursor - 0.5) / ui.scale - float2(3.5, 3.5)
    let dist = length(px_local)

    let rim_mask = saturate(5.0 - dist)
    let outer_mask = saturate(4.0 - dist)
    let inner_mask = saturate(2.5 - dist)

    let mouse_over = length((ui.mouse_input.xy - ui.px_cursor) / ui.scale - float2(3.5, 3.5)) < 4.0

    if mouse_over and rim_mask > 0.0 => ui.dst_color = float4(1.0, 1.0, 1.0, 1.0)

    // no AA for now
    if outer_mask > 0.0 => ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a)
    if checked and inner_mask > 0.0 => ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

    let delta = round(ui.mouse_input.xy + 0.5 - ui.px_pos)

    return mouse_over and delta.x == 0.0 and delta.y == 0.0

// e.g. if(s2h_checkBox(ui, UIState[0].UICheckboxState == 0) && leftMouseClicked) UIState[0].UICheckboxState = !UIState[0].UICheckboxState;
// @param checked fill inside using textColor
fun s2h_check_box(ui: mut context_gather, checked: bool) -> bool:
    let color = ui.button_color

    let px_local = (ui.px_pos - ui.px_cursor - 0.5) / ui.scale - float2(3.5, 3.5)
    let dist = max(abs(px_local.x), abs(px_local.y))

    let rim_mask = saturate(5.0 - dist)
    let outer_mask = saturate(4.0 - dist)
    let inner_mask = saturate(2.5 - dist)

    let mouse_over = length((ui.mouse_input.xy - ui.px_cursor) / ui.scale - float2(3.5, 3.5)) < 4.0

    if mouse_over and rim_mask > 0.0 => ui.dst_color = float4(1.0, 1.0, 1.0, 1.0)

    // no AA for now
    if outer_mask > 0.0 => ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a)
    if checked and inner_mask > 0.0 => ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

    let delta = round(ui.mouse_input.xy + 0.5 - ui.px_pos)

    return mouse_over and delta.x == 0.0 and delta.y == 0.0

// @param fraction 0..1
fun s2h_progress(ui: mut context_gather, width_in_characters: uint, fraction: float):
    let color = ui.button_color
    let mut outer_aabb = float4(
        ..ui.px_cursor,
        ..(ui.px_cursor + float2((width_in_characters as float) * s2h_font_size(), s2h_font_size() - 2.0) * ui.scale)
    )
    outer_aabb += 0.5

    // shrink
    let mut inner_aabb = outer_aabb + float4(1.0, 1.0, -1.0, -1.0) * ui.scale

    inner_aabb.z = mix(inner_aabb.x, inner_aabb.z, saturate(fraction))

    let slider_dist = s2h_compute_dist_to_box(ui, ui.px_pos, outer_aabb)
    let inner_dist = s2h_compute_dist_to_box(ui, ui.px_pos, inner_aabb)

    let mut local_color = float4(0.0, 0.0, 0.0, 0.0)

    // no AA for now
    if slider_dist <= 0.0 => local_color = color

    if inner_dist <= 0.0 => local_color = mix(local_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += (width_in_characters as float) * s2h_font_size() * ui.scale

    ui.dst_color = mix(ui.dst_color, float4(..local_color.rgb, 1.0), local_color.a * (1.0 - ui.dst_color.a))

fun s2h_slider_float(ui: mut context_gather, width_in_characters: uint, value: mut float, min_value: float, max_value: float):
    let color = ui.button_color
    let mut outer_aabb = float4(
        ..ui.px_cursor,
        ..(ui.px_cursor + float2((width_in_characters as float) * s2h_font_size(), s2h_font_size() - 2.0) * ui.scale)
    )
    outer_aabb += 0.5

    let half_char = s2h_font_size() / 2.0

    // shrink
    let inner_aabb = outer_aabb + float4(1.0, 1.0, -1.0, -1.0) * ui.scale

    let slider_dist = s2h_compute_dist_to_box(ui, ui.px_pos, outer_aabb)

    // todo: active button should be made for all UI interactive buttons (checkbox, radio, button)
    let current_mouse = if ui.s2h_state.x == 0 and ui.s2h_state.y == 0 => ui.mouse_input.xy else float2(ui.s2h_state.xy)

    let mouse_over = s2h_compute_dist_to_box(ui, current_mouse, outer_aabb) <= 0.0

    let mut knob_color = ui.text_color.rgb

    // mouse over and left mouse button pressed
    if mouse_over and ui.mouse_input.z != 0.0:
        let new_fraction = saturate((ui.mouse_input.x - inner_aabb.x) / (inner_aabb.z - inner_aabb.x))
        value = mix(min_value, max_value, new_fraction)

        knob_color = float3(1.0, 1.0, 1.0)

        // todo: active button should be made for all UI interactive buttons (checkbox, radio, button)
        if ui.s2h_state.x == 0 and ui.s2h_state.y == 0 => ui.s2h_state.xy = int2(ui.mouse_input.xy)

    let fraction = saturate((value - min_value) / (max_value - min_value))

    let knob_range = ((width_in_characters as float) - 1.0) * s2h_font_size() * ui.scale
    let knob_pos = ui.px_cursor + float2(half_char * ui.scale, 0.0) + float2(fraction * knob_range, 3.0 * ui.scale)
    let knob_size = float2(s2h_font_size() - 4.0, s2h_font_size() - 4.0) * 0.5 * ui.scale
    let mut knob_aabb = float4(..(knob_pos - knob_size), ..(knob_pos + knob_size))
    knob_aabb += 0.5

    let knob_dist = s2h_compute_dist_to_box(ui, ui.px_pos, knob_aabb)

    let mut local_color = float4(0.0, 0.0, 0.0, 0.0)

    if mouse_over and slider_dist <= 2.0 => local_color = float4(1.0, 1.0, 1.0, 1.0)

    // no AA for now
    if slider_dist <= 0.0 => local_color = color

    //	if(innerDist <= 0.0f)
    //		localColor = lerp(localColor, float4(ui.textColor.rgb, 1), ui.textColor.a);

    if knob_dist <= 0.0 => local_color = mix(local_color, float4(..knob_color, 1.0), ui.text_color.a)

    ui.px_cursor.x += (width_in_characters as float) * s2h_font_size() * ui.scale

    ui.dst_color = mix(ui.dst_color, float4(..local_color.rgb, 1.0), local_color.a * (1.0 - ui.dst_color.a))

// LDR color (0..1 range)
fun s2h_slider_rgb(ui: mut context_gather, width_in_characters: uint, value: mut float3):
    let r = 3.0 * s2h_font_size() * 0.5 * ui.scale - 1.0
    let backup = ui.button_color

    let initial_pos = ui.px_cursor
    let pos = initial_pos + float2(3.0 * s2h_font_size() * ui.scale, 0.0)

    ui.px_cursor.x = pos.x
    ui.button_color = float4(1.0, 0.1, 0.1, 1.0)
    s2h_slider_float(mut ui, width_in_characters - 3u, mut value.r, 0.0, 1.0)
    s2h_print_lf(mut ui)

    ui.px_cursor.x = pos.x
    ui.button_color = float4(0.0, 1.0, 0.0, 1.0)
    s2h_slider_float(mut ui, width_in_characters - 3u, mut value.g, 0.0, 1.0)
    s2h_print_lf(mut ui)

    ui.px_cursor.x = pos.x
    ui.button_color = float4(0.2, 0.2, 1.0, 1.0)
    s2h_slider_float(mut ui, width_in_characters - 3u, mut value.b, 0.0, 1.0)
    s2h_print_lf(mut ui)

    // todo: don't abuse circle drawing for disk drawing
    // todo: check if sRGB blending is right, it looks wrong with white
    s2h_draw_disc(mut ui, initial_pos + r, r, float4(..value, 1.0))

    ui.px_cursor = initial_pos + float2((width_in_characters as float) * s2h_font_size() * ui.scale, 0.0)

    ui.button_color = backup

fun print_disc_ex(ui: mut context_gather, color: float4):
    s2h_print_disc(mut ui, color)
    s2h_print_txt(mut ui, _SPACE)
    s2h_print_int(mut ui, (color.r * 255.9) as int)
    s2h_print_txt(mut ui, _COMMA)
    s2h_print_int(mut ui, (color.g * 255.9) as int)
    s2h_print_txt(mut ui, _COMMA)
    s2h_print_int(mut ui, (color.b * 255.9) as int)

@pixel fun main(p: varyings){params} -> target:
    let mut ui = s2h_init(s2h_get_pixel_coord(p.position.xy))
    ui.mouse_input = params.s2h_mouse
    s2h_set_cursor(mut ui, float2(10.0, 10.0))

    ui.text_color.rgb = float3(1.0, 1.0, 1.0)
    s2h_set_scale(mut ui, 3.0)
    s2h_print_txt(mut ui, _G, _a, _t, _h, _e, _r)
    s2h_print_txt(mut ui, _T, _e, _s, _t)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)

    ui.text_color.rgb = float3(0.0, 0.0, 0.0)
    s2h_set_scale(mut ui, 2.0)
    s2h_print_txt(mut ui, _P, _i, _x, _e, _l, _EQUAL)
    s2h_print_txt(mut ui, _T, _h, _r, _e, _a, _d)
    s2h_set_scale(mut ui, 3.0)
    s2h_print_lf(mut ui)

    s2h_set_scale(mut ui, 1.0)
    ui.text_color.rgb = float3(1.0, 0.0, 0.0)
    s2h_print_txt(mut ui, _R)
    ui.text_color.rgb = float3(0.0, 1.0, 0.0)
    s2h_print_txt(mut ui, _G)
    ui.text_color.rgb = float3(0.0, 0.0, 1.0)
    s2h_print_txt(mut ui, _B)
    s2h_print_txt(mut ui, _SPACE)
    ui.text_color.rgb = float3(0.0, 0.0, 0.0)
    s2h_print_txt(mut ui, _X, _Y, _Z, _COLON)
    s2h_print_lf(mut ui)
    s2h_print_int(mut ui, 12345)
    s2h_print_lf(mut ui)
    s2h_print_int(mut ui, -12345)
    s2h_print_lf(mut ui)
    s2h_print_hex(mut ui, 0x1297ABu)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)

    s2h_set_scale(mut ui, 2.0)
    s2h_print_float(mut ui, -12.34)
    s2h_print_txt(mut ui, _COMMA)
    s2h_print_float(mut ui, 0.34)
    s2h_print_lf(mut ui)
    s2h_print_box(mut ui, float4(1.0, 0.7, 0.3, 1.0))
    s2h_print_box(mut ui, float4(1.0, 0.0, 0.0, 1.0))
    s2h_print_disc(mut ui, float4(0.0, 1.0, 0.0, 1.0))
    s2h_print_disc(mut ui, float4(1.0, 1.0, 0.0, 1.0))

    let radio_state = params.s2h_ui_state.x as uint
    let checkbox_state = params.s2h_ui_state.y as uint
    let mut slider_alpha = params.s2h_ui_state.z
    let mut slider_color = params.s2h_color.rgb

    // The original's BGFX_SHADER_LANGUAGE_WGSL arm is a shorter port, since shaderc's WGSL backend overflows its compiler stack on this one.
    // This is the full port, for every target.
    s2h_set_scale(mut ui, 2.0)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _U, _I, _S, _t, _a, _t)
    s2h_print_txt(mut ui, _e, _COLON, _SPACE, _LESS, _MINUS, _MINUS)
    s2h_print_txt(mut ui, _SPACE, _T, _o, _u, _c, _h)
    s2h_print_txt(mut ui, _SPACE, _M, _e)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _SPACE, _SPACE)
    s2h_print_int(mut ui, radio_state as int)
    s2h_print_txt(mut ui, _SPACE, _EQUAL, _SPACE)
    let button_color = ui.button_color
    ui.button_color = float4(1.0, 0.0, 0.0, 1.0)
    s2h_radio_button(mut ui, radio_state == 1u)
    ui.button_color = float4(0.0, 1.0, 0.0, 1.0)
    s2h_radio_button(mut ui, radio_state == 2u)
    ui.button_color = float4(0.0, 0.0, 1.0, 1.0)
    s2h_radio_button(mut ui, radio_state == 3u)
    ui.button_color = button_color
    s2h_print_txt(mut ui, _SPACE, _s, _2, _h, _UNDERSCORE, _r)
    s2h_print_txt(mut ui, _a, _d, _i, _o, _B, _u)
    s2h_print_txt(mut ui, _t, _t, _o, _n)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _SPACE, _SPACE)
    s2h_print_int(mut ui, radio_state as int)
    s2h_print_txt(mut ui, _SPACE, _EQUAL, _SPACE)
    s2h_print_txt(mut ui, _C, _l, _e, _a, _r)
    s2h_button(mut ui, 5u)
    s2h_print_txt(mut ui, _SPACE, _s, _2, _h, _UNDERSCORE, _b)
    s2h_print_txt(mut ui, _u, _t, _t, _o, _n)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _SPACE, _SPACE)
    s2h_print_int(mut ui, checkbox_state as int)
    s2h_print_txt(mut ui, _SPACE, _EQUAL, _SPACE)
    s2h_check_box(mut ui, checkbox_state != 0u)
    s2h_print_txt(mut ui, _SPACE, _s, _2, _h, _UNDERSCORE, _c)
    s2h_print_txt(mut ui, _h, _e, _c, _k, _B, _o)
    s2h_print_txt(mut ui, _x)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _SPACE, _SPACE)
    s2h_progress(mut ui, 5u, fract(params.s2h_time.x))
    s2h_print_txt(mut ui, _SPACE, _s, _2, _h, _UNDERSCORE, _p)
    s2h_print_txt(mut ui, _r, _o, _g, _r, _e, _s)
    s2h_print_txt(mut ui, _s)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _SPACE, _SPACE)
    s2h_slider_float(mut ui, 8u, mut slider_alpha, 0.0, 1.0)
    s2h_print_txt(mut ui, _SPACE, _s, _2, _h, _UNDERSCORE, _s)
    s2h_print_txt(mut ui, _l, _i, _d, _e, _r, _F)
    s2h_print_txt(mut ui, _l, _o, _a, _t)
    s2h_print_lf(mut ui)
    s2h_print_lf(mut ui)
    s2h_print_txt(mut ui, _SPACE, _SPACE)
    s2h_slider_rgb(mut ui, 8u, mut slider_color)
    s2h_print_txt(mut ui, _SPACE, _s, _2, _h, _UNDERSCORE, _s)
    s2h_print_txt(mut ui, _l, _i, _d, _e, _r, _R)
    s2h_print_txt(mut ui, _G, _B)

    let background = float4(0.4, 0.7, 0.4, 1.0)
    return {
        color = mix(background, float4(..ui.dst_color.rgb, 1.0), ui.dst_color.a)
    }
