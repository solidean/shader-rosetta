// Port of ShaderToHuman-bgfx/examples/Features/Gather_example.hlsl.
// Widget state comes from the ImGui host controls, not a UAV as in the original.

binding params:
    s2h_time: float4
    s2h_ui_state: float4
    s2h_color: float4
    s2h_mouse: float4

struct varyings:
    @position position: hpos4
    color0: float4
    texcoord0: float2

@pixel struct target:
    color: float4

// ---- s2h_bgfx.sh ----

// S2H uses a top-left pixel origin; bgfx_ndc.z is the OpenGL origin sign.
// The original's GLSL arm flips y by it; no SGL target has GL's origin, so this is its other arm.
fun s2h_get_pixel_coord(fragment_coord: float2) -> float2:
    return fragment_coord

// ---- s2h.hlsl ----

// pixel shader or compute shader looping through all pixels
struct context_gather:
    // in pixels, no fractional part (half pixel offset)
    px_cursor: float2
    // 1/2/3/4
    scale: float
    // .xy:-100,-100 if not yet set, .xy:absolutePos, z:leftMouse 0/1, w:rightMouse 0/1, no fractional part (half pixel offset)
    mouse_input: float4

    // window left top, no fractional part (half pixel offset), set by s2h_setPos(), used by s2h_printLF()
    px_left_x: float
    // in pixels, no fractional part (half pixel offset), set by s2h_init()
    px_pos: float2
    // premultiplied RGBA, alpha 1 is assumed to be opaque, don't init with a color or s2h_button() will not work
    dst_color: float4

    // RGBA, alpha 1 is assumed to be opaque, s2h_progress()
    text_color: float4
    // for s2h_frame()
    frame_fill_color: float4
    // for s2h_frame()
    frame_border_color: float4
    // for s2h_button(), s2h_checkbox(), s2h_radiobutton, s2h_progress(), s2h_sliderFloat()
    button_color: float4
    line_width: float

    // private ----------------------

    // for interactive UI, read int4 state from former frame
    s2h_state: int4

// You can define this to provide your own font (different size, visual or better lookup performance by using a texture)
