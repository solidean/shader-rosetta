// The original carries no copyright line; bgfx: Copyright 2010-2026 Branimir Karadzic. BSD-2-Clause: sources/bgfx/LICENSE.

binding material:
    scatter_color: texture_2d[float4]
    sampler s_scatter_color:
        filter = .linear

struct varyings:
    @position position: hpos4
    color0: float4
    texcoord0: float2

@pixel struct target:
    color: float4

@pixel fun main(p: varyings){material} -> target:
    return {
        color = material.scatter_color.sample(p.texcoord0, material.s_scatter_color)
    }
