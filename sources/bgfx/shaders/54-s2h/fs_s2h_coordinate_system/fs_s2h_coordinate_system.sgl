// todo: consider define or static cost int or float
// 8x8 font
fun s2h_font_size() -> float:
    return 8.0

// don't use directly
// can be used for scatter and gather
// @param ascii 32..127 are valid characters
// @param pxPos int2(0..s2h_fontSize()-1, 0..s2h_fontSize-1)
// @return true if there should be a pixel, false if not or outside the valid range
fun s2h_font_lookup(ascii: uint, px_pos: int2) -> bool:
    if (px_pos.x as uint) >= 8u or (px_pos.y as uint) >= 8u => return false

    if ascii <= 32u or ascii > 127u => return false

    // 0..16*6-1
    let chr = ascii - 32u
    // uint2(0..127, 0..47)
    let chr_pos = uint2(chr % 16u, chr / 16u)
    let pixel = uint2(chr_pos.x * 8u + (px_pos.x as uint), chr_pos.y * 8u + (px_pos.y as uint))
    let dword_id = pixel.x / 32u + (pixel.y * 4u)
    // 0..31
    let bit_id = pixel.x & 0x1fu

    // 0..ff
    let dword_value = g_mini_font[dword_id]

    return ((dword_value >> (31u - bit_id)) & 1u) != 0u

// don't use directly
fun s2h_print_character(ui: mut context_gather, ascii: uint):
    let px_local = int2(floor((ui.px_pos - ui.px_cursor) / ui.scale))

    if s2h_font_lookup(ascii, px_local):
        ui.dst_color = mix(ui.dst_color, float4(..ui.text_color.rgb, 1.0), ui.text_color.a)

    ui.px_cursor.x += s2h_font_size() * ui.scale

const _A = 65u
const _C = 67u
const _D = 68u
const _E = 69u
const _H = 72u
const _I = 73u
const _M = 77u
const _N = 78u
const _O = 79u
const _R = 82u
const _S = 83u
const _T = 84u
const _Y = 89u
const _a = _A + 32u
const _c = _C + 32u
const _d = _D + 32u
const _e = _E + 32u
const _h = _H + 32u
const _i = _I + 32u
const _m = _M + 32u
const _n = _N + 32u
const _o = _O + 32u
const _r = _R + 32u
const _s = _S + 32u
const _t = _T + 32u
const _y = _Y + 32u
const _UNDERSCORE = 95u // _
const _2 = 50u

// first call this
fun s2h_init(in_px_pos: float2) -> context_gather:
    return {
        // white, opaque
        text_color = float4(1.0, 1.0, 1.0, 1.0)
        px_left_x = 0.0
        px_cursor = float2(0.0, 0.0)
        scale = 1.0
        mouse_input = float4(-100.0, -100.0, 0.0, 0.0)

        px_pos = in_px_pos
        // see through
        dst_color = float4(0.0, 0.0, 0.0, 0.0)
        s2h_state = int4(0, 0, 0, 0)

        frame_fill_color = float4(0.9, 0.9, 0.9, 1.0)
        frame_border_color = float4(0.7, 0.7, 0.7, 1.0)
        button_color = float4(0.5, 0.5, 0.5, 1.0)
        line_width = 2.0
    }

// set text cursor position, next printLF() will reset to this x position
fun s2h_set_cursor(ui: mut context_gather, in_px_left_top: float2):
    ui.px_cursor = in_px_left_top
    ui.px_left_x = in_px_left_top.x

// @param scale 1:pixel perfect, 2:2x, 3:3x, ..
fun s2h_set_scale(ui: mut context_gather, scale: float):
    ui.scale = scale

// e.g. ui.s2h_printTxt('I', ' ', 'a', 'm');
// @param a ascii character or 0
fun s2h_print_txt(ui: mut context_gather, a: uint):
    s2h_print_character(mut ui, a)

// glsl has no default arguments to we implement multiple functions instead making porting easier
fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint):
    s2h_print_txt(mut ui, a)
    s2h_print_character(mut ui, b)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint):
    s2h_print_txt(mut ui, a, b)
    s2h_print_character(mut ui, c)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint):
    s2h_print_txt(mut ui, a, b, c)
    s2h_print_character(mut ui, d)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint, e: uint):
    s2h_print_txt(mut ui, a, b, c, d)
    s2h_print_character(mut ui, e)

fun s2h_print_txt(ui: mut context_gather, a: uint, b: uint, c: uint, d: uint, e: uint, f: uint):
    s2h_print_txt(mut ui, a, b, c, d, e)
    s2h_print_character(mut ui, f)

// draw not anti aliased rectangle (fast and simple),
// @param pxLeftTop included
// @param pxBottomRight excluded
fun s2h_draw_rectangle(ui: mut context_gather, px_left_top: float2, px_bottom_right: float2, color: float4):
    if ui.px_pos.x >= px_left_top.x and ui.px_pos.y >= px_left_top.y and ui.px_pos.x < px_bottom_right.x and ui.px_pos.y < px_bottom_right.y:
        ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a)

// hard edges, anti aliased, px position should be pixel centered (+0.5)
// uses ui.lineWidth
fun s2h_draw_line(ui: mut context_gather, px_begin: float2, px_end: float2, color: float4):
    let px_thickness = ui.line_width + 1.0
    let r = px_thickness * 0.5
    let delta = px_end - px_begin
    let len = length(delta)
    if len > 0.01:
        let tangent = delta / len
        let normal = float2(tangent.y, -tangent.x)
        let local = ui.px_pos - px_begin
        let uv = float2(dot(local, tangent), dot(local, normal))
        // 0...1
        let mask = saturate(r - abs(uv.y)) * saturate(r - uv.x + len) * saturate(r + uv.x)

        ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a * mask)

fun s2h_get_half_space_plane(point_a: float2, point_b: float2) -> float3:
    let point_delta = point_a - point_b
    let ab = point_delta / max(length(point_delta), 0.0001)
    let mut ab_plane = float3(-ab.y, ab.x, 0.0)
    ab_plane.z = dot(ab_plane.xy, -point_a)

    return ab_plane

// anti aliased px position should be pixel centered (+0.5)
fun s2h_draw_triangle(ui: mut context_gather, tri: s2h_triangle, color: float4):
    let ab_plane = s2h_get_half_space_plane(tri.a, tri.b)
    let ab_mask = saturate(dot(ab_plane, float3(..ui.px_pos, 1.0)) - 0.5)

    let bc_plane = s2h_get_half_space_plane(tri.b, tri.c)
    let bc_mask = saturate(dot(bc_plane, float3(..ui.px_pos, 1.0)) - 0.5)

    let ca_plane = s2h_get_half_space_plane(tri.c, tri.a)
    let ca_mask = saturate(dot(ca_plane, float3(..ui.px_pos, 1.0)) - 0.5)

    let mask = ab_mask * bc_mask * ca_mask
    ui.dst_color = mix(ui.dst_color, float4(..color.rgb, 1.0), color.a * mask)

// anti aliased px position should be pixel centered (+0.5)
// uses ui.lineWidth
fun s2h_draw_arrow(ui: mut context_gather, px_start: float2, px_end: float2, color: float4, arrow_head_length: float, arrow_head_width: float):
    let direction_vector = px_end - px_start
    let direction_length = max(length(direction_vector), 0.0001)
    let direction = direction_vector / direction_length

    let line_start = px_start
    // Subtract the arrow length from lineEnd - arrow fits in pxStart...pxEnd
    let line_end = px_end - direction * arrow_head_length

    let perpendicular_dir = float2(direction.y, -direction.x)

    s2h_draw_line(mut ui, line_start, line_end, color)

    let tri_a: s2h_triangle = {
        a = line_end - perpendicular_dir * arrow_head_width
        b = line_end + direction * arrow_head_length
        c = line_end + perpendicular_dir * arrow_head_width
    }
    s2h_draw_triangle(mut ui, tri_a, color)

// draw a cartesian XY coordinate system with 2 arrows and unit markers
// using ui.textColor and ui.lineWidth
// @param pxOrigin position of 0,0 in pixel coordinates
// @param domain (minX, minY)-(maxX, maxY)
// @param pxScale one domain unit in pixels
// @param gridSize in unit space
// @param gridColor e.g. float4(1.0f, 1.0f, 1.0f, 0.25f)
// @param flags defaut:0, add up bit values, 0x1:Y is up, 0x2:gridLines
fun s2h_coordinate_system(ui: mut context_gather, px_origin: float2, domain: float4, px_scale: float, grid_size: float, grid_color: float4, flags: uint):
    // floor() to snap to pixel grid for consistent visuals
    let px_origin = floor(px_origin)

    let y_is_up = (flags & 0x1u) != 0u
    let grid_lines = (flags & 0x2u) != 0u

    let color = ui.text_color

    let px_dot_size = ui.line_width
    // todo: refine math to be consistent in grid size
    let px_d = fract(floor(ui.px_pos - px_origin + px_dot_size / 2.0) / grid_size) * grid_size

    let mut grid_color = grid_color
    if grid_lines:
        if px_d.x > floor(px_dot_size) and px_d.y > floor(px_dot_size) => grid_color = float4(0.0, 0.0, 0.0, 0.0)
    else:
        if px_d.x > floor(px_dot_size) or px_d.y > floor(px_dot_size) => grid_color = float4(0.0, 0.0, 0.0, 0.0)

    let px_domain = domain * px_scale + float4(..px_origin, ..px_origin)

    s2h_draw_rectangle(mut ui, px_domain.xy, px_domain.zw, grid_color)

    let backup_line_width = ui.line_width

    // X axis
    if px_d.x < backup_line_width => ui.line_width *= 2.0
    s2h_draw_arrow(mut ui, float2(px_domain.x, px_origin.y), float2(px_domain.z, px_origin.y), color, 16.0, 8.0)

    // Y axis
    ui.line_width = backup_line_width
    if px_d.y < backup_line_width => ui.line_width *= 2.0

    if y_is_up:
        s2h_draw_arrow(mut ui, float2(px_origin.x, px_domain.w), float2(px_origin.x, px_domain.y), color, 16.0, 8.0)
    else:
        s2h_draw_arrow(mut ui, float2(px_origin.x, px_domain.y), float2(px_origin.x, px_domain.w), color, 16.0, 8.0)

    ui.line_width = backup_line_width

@pixel fun main(p: varyings) -> target:
    let background = float4(0.01, 0.01, 0.1, 1.0)

    let pixel_position = floor(s2h_get_pixel_coord(p.position.xy)) + 0.5
    let mut ui = s2h_init(pixel_position)
    s2h_set_scale(mut ui, 2.0)
    s2h_set_cursor(mut ui, float2(10.0, 10.0))

    s2h_coordinate_system(mut ui, float2(50.0, 130.0), float4(-30.0, -30.0, 250.0, 250.0), 1.0, 20.0, float4(1.0, 1.0, 1.0, 0.25), 0u)
    ui.line_width = 1.0
    s2h_coordinate_system(mut ui, float2(440.0, 150.0), float4(-10.0, -120.0, 150.0, 10.0), 1.0, 20.0, float4(1.0, 1.0, 1.0, 0.25), 3u)

    s2h_print_txt(mut ui, _s, _2, _h, _UNDERSCORE)
    s2h_print_txt(mut ui, _c, _o, _o, _r, _d, _i)
    s2h_print_txt(mut ui, _n, _a, _t, _e, _S, _y)
    s2h_print_txt(mut ui, _s, _t, _e, _m)

    return {
        color = mix(background, float4(..ui.dst_color.rgb, 1.0), ui.dst_color.a)
    }
