binding params:
    id: float4

struct varyings:
    @position position: hpos4
    pos: float3
    view: float3
    normal: float3
    color0: float4

@pixel struct target:
    color: float4

@pixel fun main(p: varyings){params} -> target:
    // This is dumb, should use u8 texture
    return {
        color = float4(..params.id.xyz, 1.0)
    }
