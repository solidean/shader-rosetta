binding view:
    model_view: mat4
    model_view_proj: mat4

binding params:
    tint: float4

@vertex struct vertex_input:
    position: pos3
    normal: float3

struct varyings:
    @position position: hpos4
    pos: float3
    view: float3
    normal: float3
    color0: float4

@vertex fun main(v: vertex_input){view, params} -> varyings:
    let pos = v.position
    let normal = v.normal.xyz * 2.0 - 1.0

    let position = view.model_view_proj * pos
    return {
        position = position
        pos = position.xyz
        view = (view.model_view * pos).xyz
        normal = (view.model_view * float4(..normal, 0.0)).xyz
        color0 = params.tint * float4(0.8, 0.8, 0.8, 1.0)
    }
