binding view:
    view_proj: mat4

@vertex struct vertex_input:
    position: float2
    texcoord0: float2

struct varyings:
    @position position: hpos4
    texcoord0: float2

@vertex fun main(v: vertex_input){view} -> varyings:
    return {
        position = view.view_proj * pos3(..v.position, 0.0)
        texcoord0 = v.texcoord0
    }
