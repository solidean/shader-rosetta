binding view:
    view_proj: mat4

@vertex struct vertex_input:
    position: float2
    texcoord0: float2
    color0: float4

struct varyings:
    @position position: hpos4
    color0: float4
    texcoord0: float2

@vertex fun main(v: vertex_input){view} -> varyings:
    let pos = view.view_proj * float4(..v.position, 0.0, 1.0)
    return {
        position = hpos4(pos.x, pos.y, 0.0, 1.0)
        texcoord0 = v.texcoord0
        color0 = v.color0
    }
