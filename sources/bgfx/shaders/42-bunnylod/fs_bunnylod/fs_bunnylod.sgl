struct varyings:
    @position position: hpos4
    world: float3
    color0: float4

@pixel struct target:
    color: float4

@pixel fun main(p: varyings) -> target:
    let normal = normalize(cross(vec3(..ddx(p.world)), vec3(..ddy(p.world))))
    let light_dir = vec3(0.0, 0.0, 1.0)
    let ndotl = max(dot(normal, light_dir), 0.0)
    let spec = pow(ndotl, 30.0)
    return {
        color = pow(pow(p.color0, float4(2.2)) * ndotl + spec, float4(1.0 / 2.2))
    }
