// Translated to SGL from bgfx examples/24-nbody/fs_particle.sc.
// Copyright 2014 Stanlo Slasinski. BSD-2-Clause: sources/bgfx/LICENSE.

binding params:
    particle_intensity: float
    particle_power: float

struct varyings:
    @position position: hpos4
    tex_coord: float3

@pixel struct target:
    color: float4

@pixel fun main(v: varyings){params} -> target:
    let color = mix(float3(0.1, 0.8, 0.2), 0.5 * float3(0.3, 0.25, 0.05), v.tex_coord.z)
    let f = params.particle_intensity * pow(max(1.0 - length(v.tex_coord.xy), 0.0), params.particle_power)
    return {
        color = float4(..(color * f), 1.0)
    }
