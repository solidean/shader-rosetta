// Copyright 2015 Andrew Mac. BSD-2-Clause: sources/bgfx/LICENSE.

binding view:
    model_view_proj: mat4

@vertex struct vertex_input:
    position: float3
    texcoord0: float2

struct varyings:
    @position position: hpos4
    // bgfx's v_position
    pos: float3
    texcoord0: float2

@vertex fun main(v: vertex_input){view} -> varyings:
    let pos = v.position.xyz
    return {
        position = view.model_view_proj * pos3(..pos.xyz)
        pos = pos
        texcoord0 = v.texcoord0
    }
