binding view:
    model_view_proj: mat4
    model: mat4

@vertex struct vertex_input:
    position: pos3
    normal: float4
    texcoord0: float2

struct varyings:
    @position position: hpos4
    normal: float3
    texcoord0: float2

@vertex fun main(v: vertex_input){view} -> varyings:
    let normal = v.normal.xyz * 2.0 - 1.0
    return {
        position = view.model_view_proj * v.position
        normal = (view.model * float4(..normal, 0.0)).xyz
        texcoord0 = v.texcoord0
    }
