// Translated to SGL from bgfx examples/36-sky/fs_sky_color_banding_fix.sc.
// Copyright 2017 Stanislav Pidhorskyi. BSD-2-Clause: sources/bgfx/LICENSE.

binding params:
    // x - sun size, y - sun bloom, z - exposition, w - time
    parameters: float4
    sun_direction: float4
    sun_luminance: float4

struct varyings:
    @position position: hpos4
    sky_color: float3
    screen_pos: float2
    view_dir: float3

@pixel struct target:
    color: float4

// Interleaved gradient noise (better for Metal)
// Reference: http://www.iryoku.com/next-generation-post-processing-in-call-of-duty-advanced-warfare
fun interleaved_gradient_noise(screen_pos: float2, temporal_factor: float) -> float:
    let magic = float3(0.06711056, 0.00583715, 52.9829189)
    let coord = screen_pos + fract(temporal_factor) * float2(13.0)
    return fract(magic.z * fract(dot(coord, magic.xy)))

// shaderlib.sh
fun to_gamma(rgb: float3) => pow(abs(rgb), float3(1.0 / 2.2))

@pixel fun main(p: varyings){params} -> target:
    let size2 = params.parameters.x * params.parameters.x

    let light_dir = normalize(params.sun_direction.xyz)
    let distance = 2.0 * (1.0 - dot(normalize(p.view_dir), light_dir))
    let sun = exp(-distance / params.parameters.y / size2) + step(distance, size2)
    let sun2 = min(sun * sun, 1.0)
    let mut color = to_gamma(p.sky_color + sun2)

    let mut dither = interleaved_gradient_noise(p.position.xy, params.parameters.w)
    dither = (dither - 0.5) / 255.0
    color += float3(dither)

    return {
        color = float4(..color, 1.0)
    }
