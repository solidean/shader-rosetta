require vertex_layer_output

binding view:
    model_view_proj: mat4

binding params:
    // x = eye separation
    eye_params: float4

@vertex struct vertex_input:
    position: pos3
    color0: float4

struct varyings:
    @position position: hpos4
    color0: float4
    eye: float
    @layer layer: uint

@vertex fun main(v: vertex_input, @instance_index instance: int){view, params} -> varyings:
    let eye_index = instance as float

    let mut pos = view.model_view_proj * v.position
    pos.x += (eye_index * 2.0 - 1.0) * params.eye_params.x * pos.w
    return {
        position = pos
        color0 = v.color0
        eye = eye_index
        layer = instance as uint
    }
