binding view:
    model_view_proj: mat4

@vertex struct vertex_input:
    position: float2
    color0: float4
    texcoord0: float4

struct varyings:
    @position position: hpos4
    color0: float4
    texcoord0: float4

@vertex fun main(v: vertex_input){view} -> varyings:
    return {
        position = view.model_view_proj * pos3(..v.position, 0.0)
        color0 = v.color0
        texcoord0 = v.texcoord0
    }
