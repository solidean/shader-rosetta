// Translated to SGL from bgfx examples/common/font/fs_font_distance_field_outline_drop_shadow_image.sc.
// Copyright 2010-2026 Branimir Karadzic, bgfx's line, since the original names none. BSD-2-Clause: sources/bgfx/LICENSE.

binding material:
    tex_color: texture_cube[float4]
    sampler s_tex:
        filter = .linear

// bgfx's u_dropShadowColor, declared and never read, and u_params, one member per define
binding params:
    drop_shadow_color: float4
    unused: float
    distance_multiplier: float
    drop_shadow_softener: float
    outline_width: float

struct varyings:
    @position position: hpos4
    color0: float4
    color1: float4
    texcoord0: float4
    texcoord1: float4
    texcoord2: float4

@pixel struct target:
    color: float4

@pixel fun main(p: varyings){material, params} -> target:
    // the samples and derivatives each branch reads, taken before the branches on a varying
    let image_color = material.tex_color.sample(p.texcoord1.xyz, material.s_tex)
    let shadow_tex_coord = p.texcoord2
    let shadow_distance_color = material.tex_color.sample(shadow_tex_coord.xyz, material.s_tex)
    let shadow_width = length(fwidth(shadow_tex_coord.xyz))
    let color = material.tex_color.sample(p.texcoord0.xyz, material.s_tex)
    let width = length(fwidth(p.texcoord0.xyz))

    if not any(equal(p.texcoord1.xyz, float3(0.0, 0.0, 0.0))):
        return {
            color = float4(..image_color.xyz, image_color.w * p.color0.w)
        }

    if not any(equal(p.texcoord2.xyz, float3(0.0, 0.0, 0.0))):
        let index2 = (shadow_tex_coord.w * 4.0 + 0.5) as int
        let rgba2: float[4] = [shadow_distance_color.z, shadow_distance_color.y, shadow_distance_color.x, shadow_distance_color.w]
        let shadow_distance = rgba2[index2]

        let mut shadow_smoothing = 16.0 * shadow_width / sqrt(2.0) * params.distance_multiplier

        let outline_width = params.outline_width * shadow_smoothing
        let outer_edge_center = 0.5 - outline_width

        shadow_smoothing = shadow_smoothing * params.drop_shadow_softener
        let shadow_alpha = smoothstep(outer_edge_center - shadow_smoothing, outer_edge_center + shadow_smoothing, shadow_distance)
        let shadow_color = float4(..p.color0.xyz, shadow_alpha * p.color0.w)
        return {
            color = shadow_color
        }

    let index = (p.texcoord0.w * 4.0 + 0.5) as int
    let rgba: float[4] = [color.z, color.y, color.x, color.w]
    let distance = rgba[index]

    let smoothing = 16.0 * width / sqrt(2.0) * params.distance_multiplier

    let outline_width = params.outline_width * smoothing
    let outer_edge_center = 0.5 - outline_width
    let alpha = smoothstep(outer_edge_center - smoothing, outer_edge_center + smoothing, distance)
    let border = smoothstep(0.5 - smoothing, 0.5 + smoothing, distance)
    let sdf_color = float4(..mix(p.color1.xyz, p.color0.xyz, border), alpha * p.color0.w)
    return {
        color = sdf_color
    }
